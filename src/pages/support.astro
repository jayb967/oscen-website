---
/**
 * Support OSCEN. Hook, featured offer, ladder, anchors, promise. Zero "donation" language.
 * For-profit entity, so support / sponsor only.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SupportThankYou from "../components/SupportThankYou.astro";
import ContributorWall from "../components/ContributorWall.astro";
import HandoffOverlay from "../components/HandoffOverlay.astro";
import SupportTierCard from "../components/SupportTierCard.astro";
import {
  FEATURED_TIER, SEASONAL_TIER, CORE_TIERS, PREMIUM_TIERS, COMPANY_TIER, CUSTOM_TIER,
} from "../lib/support";
import { BRAIN_STATS } from "../data/brain";

const neurons = BRAIN_STATS.totalNeurons.toLocaleString("en-US");
---

<Base
  title="Support | OSCEN"
  description="Back the brain before it walks. Numbered Founding 100 crewnecks, a neuron with your name on it, and a front-row seat to its first steps."
>
  <Nav />

  <main class="pt-32 pb-24">
    <SupportThankYou />

    <!-- Welcome note for visitors handed off from the /invest form. -->
    <section id="support-welcome" tabindex="-1" class="max-w-5xl mx-auto px-6 mb-12 hidden focus:outline-none">
      <div class="glass rounded-xl p-6 border border-accent-blue/25">
        <p class="text-[10px] font-tech text-accent-blue uppercase tracking-[0.3em] mb-2">Your note reached us</p>
        <p class="text-sm text-text-secondary leading-relaxed max-w-2xl">
          Thanks for reaching out about investing. Our current round is for accredited investors only, so backing the brain here is the best way to be part of OSCEN today.
          We have your details and we'll reach out about anything else.
        </p>
      </div>
    </section>

    <!-- Header: the hook -->
    <section class="max-w-5xl mx-auto px-6 mb-16">
      <p class="reveal text-[10px] font-tech text-text-muted uppercase tracking-[0.3em] mb-6">Support</p>
      <h1 class="reveal font-display text-[clamp(2.5rem,6vw,4.5rem)] text-text-primary leading-[0.9]">
        Back the brain<br />
        <span class="italic gradient-text">before it walks.</span>
      </h1>
      <p class="reveal text-text-secondary mt-8 max-w-2xl text-lg leading-relaxed">
        {neurons} neurons, learning from experience instead of training data. No GPUs.
        It can't walk or talk yet. Back it now and you're one of the people who were there before it could.
      </p>
      <div class="reveal mt-8 grid grid-cols-3 gap-2 sm:gap-3 max-w-xl">
        <div class="glass rounded-lg p-3 sm:p-4">
          <div class="text-base sm:text-xl font-tech text-accent-blue">{neurons}</div>
          <div class="text-[10px] font-tech text-text-muted uppercase tracking-wider mt-1">Neurons</div>
        </div>
        <div class="glass rounded-lg p-3 sm:p-4">
          <div class="text-base sm:text-xl font-tech text-accent-blue">0</div>
          <div class="text-[10px] font-tech text-text-muted uppercase tracking-wider mt-1">GPUs</div>
        </div>
        <div class="glass rounded-lg p-3 sm:p-4">
          <div class="text-base sm:text-xl font-tech text-accent-blue">{BRAIN_STATS.brainRegions}</div>
          <div class="text-[10px] font-tech text-text-muted uppercase tracking-wider mt-1">Brain regions</div>
        </div>
      </div>
    </section>

    <!-- Recent backers. Hidden until the CRM reports enough real backers. -->
    <section id="backers-ticker" class="max-w-5xl mx-auto px-6 mb-6 hidden" aria-label="Recent backers">
      <div class="glass rounded-xl px-5 py-4 flex flex-col md:flex-row md:items-center gap-3 md:gap-6">
        <p class="flex items-center gap-2 text-[10px] font-tech text-accent-green uppercase tracking-[0.25em] shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-green animate-pulse" aria-hidden="true"></span>
          <span id="backers-ticker-count"></span>
        </p>
        <ul id="backers-ticker-list" class="flex flex-wrap gap-x-6 gap-y-2"></ul>
      </div>
    </section>

    <!-- Offers: featured, seasonal, ladder, closer-to-the-work, company, custom.
         Tiers without a live Stripe link are filtered out in lib/support.ts. -->
    {FEATURED_TIER && (
      <section class="max-w-5xl mx-auto px-6 mb-4">
        <SupportTierCard tier={FEATURED_TIER} featured />
      </section>
    )}

    {SEASONAL_TIER && (
      <section class="max-w-5xl mx-auto px-6 mb-4">
        <SupportTierCard tier={SEASONAL_TIER} wide />
      </section>
    )}

    <section class="max-w-5xl mx-auto px-6 mb-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {CORE_TIERS.map((tier) => <SupportTierCard tier={tier} />)}
      </div>
    </section>

    {PREMIUM_TIERS.length > 0 && (
      <section class="max-w-5xl mx-auto px-6 mb-4">
        <p class="reveal text-[10px] font-tech text-text-muted uppercase tracking-[0.3em] mt-12 mb-5">Closer to the work</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {PREMIUM_TIERS.map((tier) => <SupportTierCard tier={tier} />)}
        </div>
      </section>
    )}

    {COMPANY_TIER && (
      <section class="max-w-5xl mx-auto px-6 mb-4">
        <p class="reveal text-[10px] font-tech text-text-muted uppercase tracking-[0.3em] mt-12 mb-5">For companies</p>
        <SupportTierCard tier={COMPANY_TIER} wide />
      </section>
    )}

    {CUSTOM_TIER && (
      <section class="max-w-5xl mx-auto px-6 mb-10 mt-8">
        <a
          href={CUSTOM_TIER.href}
          class="reveal glass rounded-xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 group hover:border-accent-purple/30 transition-all duration-300"
        >
          <span class="text-sm text-text-secondary"><span class="text-accent-purple font-medium">Choose your own amount.</span> {CUSTOM_TIER.stack[0]}</span>
          <span class="text-[11px] font-tech text-accent-purple/70 group-hover:text-accent-purple transition-colors shrink-0">Continue on Stripe →</span>
        </a>
      </section>
    )}

    <!-- The promise, and the fine print said plainly -->
    <section class="max-w-5xl mx-auto px-6 mb-24">
      <div class="reveal grid grid-cols-1 md:grid-cols-3 gap-3">
        <div class="glass rounded-xl p-5">
          <div class="text-sm text-text-primary font-medium">Ships when we say, or your money back</div>
          <p class="text-xs text-text-secondary mt-2 leading-relaxed">Every physical perk has a ship window on its card. If we miss it, you get a full refund.</p>
        </div>
        <div class="glass rounded-xl p-5">
          <div class="text-sm text-text-primary font-medium">Honest milestones</div>
          <p class="text-xs text-text-secondary mt-2 leading-relaxed">We never promise a date for first steps or a first word. You'll hear the wins and the misses as they happen.</p>
        </div>
        <div class="glass rounded-xl p-5">
          <div class="text-sm text-text-primary font-medium">Monthly means monthly</div>
          <p class="text-xs text-text-secondary mt-2 leading-relaxed">Cortex Circle renews each month until you cancel. Use the manage link in your welcome email, or write to info@oscen.ai, and it stops at the end of your month.</p>
        </div>
      </div>
      <p class="reveal text-[10px] text-text-muted mt-6 max-w-3xl leading-relaxed">
        OSCEN is a for-profit company, not a registered charity. Support is not tax-deductible. Perks are personal thank-you gifts.
        Support is not an investment and gives no equity, ownership, or financial return. Named neurons and sponsored regions are honorary labels kept by OSCEN.
      </p>
    </section>

    <!-- Where money goes -->
    <section class="max-w-5xl mx-auto px-6 mb-24">
      <h2 class="reveal font-display text-[clamp(1.5rem,3vw,2.5rem)] text-text-primary mb-4">Where it goes</h2>
      <p class="reveal text-sm text-text-muted mb-12 max-w-xl">No marketing budget, no fancy office. Just the cost of running brains.</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <div class="reveal glass rounded-xl p-5">
          <div class="text-2xl font-tech text-accent-blue">1M + 3</div>
          <div class="text-xs text-text-muted mt-1">Brains running in parallel</div>
          <p class="text-[10px] text-text-secondary mt-2 leading-relaxed">
            One million-neuron generalist and three 100K specialists, all learning live.
          </p>
        </div>
        <div class="reveal glass rounded-xl p-5">
          <div class="text-2xl font-tech text-accent-blue">Sensors</div>
          <div class="text-xs text-text-muted mt-1">Cameras, IMUs, mics</div>
          <p class="text-[10px] text-text-secondary mt-2 leading-relaxed">
            Real bodies need real sensors. Every contribution buys the brain new ways to feel the world.
          </p>
        </div>
        <div class="reveal glass rounded-xl p-5">
          <div class="text-2xl font-tech text-accent-blue">Runway</div>
          <div class="text-xs text-text-muted mt-1">Time to keep building</div>
          <p class="text-[10px] text-text-secondary mt-2 leading-relaxed">
            We are not VC-funded yet. Every supporter buys days of focused work on the brain instead of consulting.
          </p>
        </div>
      </div>
    </section>

    <ContributorWall />

    <!-- Other ways -->
    <section class="max-w-5xl mx-auto px-6 mb-24">
      <h2 class="reveal font-display text-[clamp(1.5rem,3vw,2.5rem)] text-text-primary mb-4">Other ways to help</h2>

      <div class="space-y-3">
        <a href="/build" class="reveal glass rounded-xl p-5 block group hover:border-accent-blue/30 transition-all duration-300">
          <h3 class="text-sm font-medium text-accent-blue group-hover:text-text-primary transition-colors">Build with us →</h3>
          <p class="text-xs text-text-secondary mt-1 leading-relaxed">Engineers, neuroscientists, roboticists. If you want to put hands on a real brain, come work on it.</p>
        </a>
        <a href="/invest" class="reveal glass rounded-xl p-5 block group hover:border-accent-blue/30 transition-all duration-300">
          <h3 class="text-sm font-medium text-accent-blue group-hover:text-text-primary transition-colors">Invest →</h3>
          <p class="text-xs text-text-secondary mt-1 leading-relaxed">Accredited investors. We're raising to extend runway and scale the body program.</p>
        </a>
        <a href="mailto:info@oscen.ai" class="reveal glass rounded-xl p-5 block group hover:border-accent-blue/30 transition-all duration-300">
          <h3 class="text-sm font-medium text-accent-blue group-hover:text-text-primary transition-colors">Just say hi →</h3>
          <p class="text-xs text-text-secondary mt-1 leading-relaxed">info@oscen.ai. Critique, encouragement, an introduction. All of it helps.</p>
        </a>
      </div>
    </section>

    <!-- Back to home -->
    <section class="max-w-5xl mx-auto px-6 text-center">
      <div class="divider max-w-24 mx-auto mb-10"></div>
      <a href="/" class="text-sm font-tech text-accent-blue/70 hover:text-accent-blue transition-colors">← Back to overview</a>
    </section>
  </main>
  <Footer />
  <HandoffOverlay mode="arrive" />
</Base>

<script>
  import { arriveFromInvest } from "../scripts/handoff";
  import { loadSupportStatus } from "../scripts/support-status";

  loadSupportStatus();

  // Real deadlines hold even if nobody redeploys after the date passes.
  document.querySelectorAll<HTMLElement>("[data-expires]").forEach((card) => {
    if (Date.now() >= Date.parse(card.dataset.expires ?? "")) card.closest("section")?.remove();
  });

  if (new URLSearchParams(location.search).get("from") === "invest") {
    const welcome = document.getElementById("support-welcome");
    welcome?.classList.remove("hidden");
    arriveFromInvest();
    // Orient keyboard and screen-reader users to the note, not the page top.
    welcome?.focus({ preventScroll: true });
  }
</script>
