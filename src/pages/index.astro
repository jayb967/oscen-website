---
/**
 * OSCEN Home. Cinematic sections over the persistent experience canvas.
 * Wonder → Problem → Solution → Inspired → How → Proof → Market → Vision → Action
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import ScrollIndicator from "../components/ScrollIndicator.astro";
import Hero from "../components/sections/Hero.astro";
import ProofStrip from "../components/sections/ProofStrip.astro";
import Problem from "../components/sections/Problem.astro";
import Solution from "../components/sections/Solution.astro";
import InspiredByYou from "../components/sections/InspiredByYou.astro";
import Proof from "../components/sections/Proof.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import Reveal from "../components/sections/Reveal.astro";
import RealWorld from "../components/sections/RealWorld.astro";
import Market from "../components/sections/Market.astro";
import Vision from "../components/sections/Vision.astro";
import ThreePaths from "../components/sections/ThreePaths.astro";
import CTA from "../components/sections/CTA.astro";
import ExperienceHUD from "../components/ExperienceHUD.astro";
import Footer from "../components/Footer.astro";
---

<Base title="OSCEN | Intelligence that grows">
  <Nav />
  <ScrollIndicator />
  <ExperienceHUD />

  <!-- Persistent experience layer. The brain canvas fills it; the OSCEN
       wordmark is tucked into the bottom-right corner as a subtle watermark
       (clear of the brain so it reads), with mix-blend-mode:screen over the
       dark background. It fades out on scroll (see initHeroScene). Section
       content paints above the whole layer via main>section z-10. -->
  <div id="experience" class="fixed inset-0 z-[1] pointer-events-none" aria-hidden="true">
    <div id="experience-canvas" class="absolute inset-0"></div>
    <div
      id="experience-title"
      class="absolute inset-0 flex items-end justify-end select-none p-6 md:p-10"
      style="font-family: var(--font-tech); font-weight: 700; font-size: clamp(2rem, 7vw, 5.5rem); line-height: 0.85; letter-spacing: -0.02em; color: rgba(226, 232, 244, 0.07); mix-blend-mode: screen;"
    >
      OSCEN
    </div>
  </div>

  <main>
    <Hero />
    <ProofStrip />
    <Problem />
    <Solution />
    <InspiredByYou />
    <Proof />
    <HowItWorks />
    <Reveal />
    <RealWorld />
    <Market />
    <Vision />
    <ThreePaths />
    <CTA />
  </main>
  <Footer />

  <script>
    import "../scripts/experience";
  </script>
</Base>
