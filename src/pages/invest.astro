---
/**
 * /invest. Public investor funnel.
 *
 * Builds the case (market, AMI validation, energy, patent moat, what's
 * built, conviction, use of funds, founder) then asks for the form.
 *
 * Form flow. accreditation fork drives downstream segment:
 *   Yes        → investor-accredited (brief + call link)
 *   Not sure   → investor-unverified (qualifying question, then brief)
 *   No         → investor-retail   (saved, then handed off to /support)
 *
 * CONFIDENTIAL. kept off this page entirely (and noindex'd under
 * /investor-pitch/*): valuation, raise size, cap table, ownership splits.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Turnstile from "../components/Turnstile.astro";
import InvestCase from "../components/invest/InvestCase.astro";
import InvestProof from "../components/invest/InvestProof.astro";
import InvestPlan from "../components/invest/InvestPlan.astro";
import HandoffOverlay from "../components/HandoffOverlay.astro";
import { SEGMENTS } from "../lib/forms";
import { BRAIN_STATS, SYNAPSES_DISPLAY } from "../data/brain";
---

<Base title="Invest | OSCEN" description="Back a brain-inspired AI for robots. Patent pending. Submit interest and we'll send the brief.">
  <Nav />

  <main class="pt-32 pb-24">
    <!-- 1. Hook -->
    <section class="max-w-5xl mx-auto px-6 mb-24">
      <p class="reveal text-[10px] font-tech text-text-muted uppercase tracking-[0.3em] mb-6">Path A · Investors</p>
      <h1 class="reveal font-display text-[clamp(2.5rem,6vw,4.5rem)] text-text-primary leading-[0.9]">
        Everyone is building the body.<br />
        <span class="italic gradient-text">We're building the brain.</span>
      </h1>
      <p class="reveal text-text-secondary mt-8 max-w-2xl text-lg leading-relaxed">
        A spiking neural network that learns continuously, with mechanisms designed to protect old skills while learning new ones, and is designed to run on a fraction of the power of today's AI. The brain is real and training right now. The body is what we build next, with you.
      </p>
    </section>

    <!-- 2-4. Market signals, why now, energy -->
    <InvestCase />

    <!-- 5-6. Patent, what's built -->
    <InvestProof />

    <!-- 7-9. Conviction, use of funds, team -->
    <InvestPlan />

    <!-- 10. The form. the conversion point -->
    <section id="investor-form" class="inv-section inv-glow max-w-3xl mx-auto px-6 mb-12 scroll-mt-24">
      <div class="text-center">
        <p class="reveal inv-eyebrow text-[10px] font-tech text-text-muted uppercase tracking-[0.3em] mb-6">Investor inquiry</p>
      </div>
      <h2 class="reveal font-display text-[clamp(2rem,4.5vw,3rem)] text-text-primary leading-tight mb-3 text-center">
        Start the <span class="italic gradient-text">conversation.</span>
      </h2>
      <p class="reveal text-sm text-text-secondary mb-10 max-w-xl mx-auto text-center">
        Tell us who you are. We'll reply within 48 hours with the brief. what we're raising, milestones, and a call link if you're a fit.
      </p>

      <form
        id="investor-form-el"
        class="reveal glass-bright glass-ticks inv-topline rounded-2xl p-7 md:p-9 space-y-6 shadow-2xl shadow-black/40"
        action="/.netlify/functions/inquiry/invest"
        method="POST"
      >
        <!-- Routing field. JS upgrades based on accreditation answer.
             Default is "unverified" so non-JS submits still land in a safe bucket. -->
        <input type="hidden" name="segment" value={SEGMENTS.investorUnverified} />
        <input type="hidden" name="_subject" value="New investor inquiry from oscen.ai" />
        <div class="hidden" aria-hidden="true">
          <label>Don't fill this: <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <label class="block">
            <span class="text-[11px] font-tech text-text-secondary uppercase tracking-wider">Name</span>
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              class="mt-2 w-full px-4 py-2.5 rounded-lg bg-deep border border-border-bright text-sm text-text-primary placeholder-text-muted focus:border-accent-blue focus:ring-2 focus:ring-accent-blue/30 focus:outline-none transition-all"
            />
          </label>
          <label class="block">
            <span class="text-[11px] font-tech text-text-secondary uppercase tracking-wider">Email</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              class="mt-2 w-full px-4 py-2.5 rounded-lg bg-deep border border-border-bright text-sm text-text-primary placeholder-text-muted focus:border-accent-blue focus:ring-2 focus:ring-accent-blue/30 focus:outline-none transition-all"
            />
          </label>
        </div>

        <!-- Accreditation. Required. No default selection. -->
        <fieldset>
          <legend class="text-[11px] font-tech text-text-secondary uppercase tracking-wider">
            Are you an accredited investor in the US?
            <span class="ml-2 text-text-muted/70 normal-case tracking-normal" title="An accredited investor has $200K+ annual income ($300K joint), $1M+ net worth excluding home, or holds qualifying licenses. SEC rule.">
              (what's this?)
            </span>
          </legend>
          <div class="mt-3 grid grid-cols-1 sm:grid-cols-3 gap-2">
            {[
              { value: "yes", label: "Yes, accredited" },
              { value: "not-sure", label: "Not sure" },
              { value: "no", label: "No, not accredited" },
            ].map((opt) => (
              <label class="cursor-pointer">
                <input type="radio" name="accreditation" value={opt.value} required class="peer sr-only" />
                <span class="block px-4 py-3 rounded-lg border border-border-bright bg-deep text-sm text-text-secondary text-center hover:border-accent-blue/40 hover:text-text-primary peer-checked:border-accent-blue peer-checked:bg-accent-blue/15 peer-checked:text-accent-blue peer-focus-visible:ring-2 peer-focus-visible:ring-accent-blue/40 transition-all">
                  {opt.label}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- Conditional fields: shown only when accreditation = yes or not-sure -->
        <div id="accredited-fields" class="hidden space-y-5">
          <label class="block">
            <span class="text-[11px] font-tech text-text-secondary uppercase tracking-wider">Check size (optional)</span>
            <select
              name="check_size"
              class="mt-2 w-full px-4 py-2.5 rounded-lg bg-deep border border-border-bright text-sm text-text-primary focus:border-accent-blue focus:ring-2 focus:ring-accent-blue/30 focus:outline-none transition-all"
            >
              <option value="">Select range</option>
              <option value="25-100k">$25K - $100K</option>
              <option value="100-500k">$100K - $500K</option>
              <option value="500k-1m">$500K - $1M</option>
              <option value="1m+">$1M+</option>
              <option value="other">Other / strategic</option>
            </select>
          </label>
          <label class="block">
            <span class="text-[11px] font-tech text-text-secondary uppercase tracking-wider">LinkedIn or website</span>
            <input
              type="url"
              name="linkedin"
              inputmode="url"
              placeholder="https://linkedin.com/in/..."
              class="mt-2 w-full px-4 py-2.5 rounded-lg bg-deep border border-border-bright text-sm text-text-primary placeholder-text-muted focus:border-accent-blue focus:ring-2 focus:ring-accent-blue/30 focus:outline-none transition-all"
            />
            <span class="text-[10px] text-text-muted mt-1 block">Helps us reply quickly. Not required but recommended.</span>
          </label>
        </div>

        <label class="block">
          <span class="text-[11px] font-tech text-text-secondary uppercase tracking-wider">Anything you want us to know? (optional)</span>
          <textarea
            name="message"
            rows="3"
            class="mt-2 w-full px-4 py-2.5 rounded-lg bg-deep border border-border-bright text-sm text-text-primary placeholder-text-muted focus:border-accent-blue focus:ring-2 focus:ring-accent-blue/30 focus:outline-none transition-all resize-none"
          ></textarea>
        </label>

        <label class="flex items-start gap-3 text-xs text-text-muted">
          <input type="checkbox" name="consent" required class="mt-0.5" style="accent-color: var(--color-accent-blue);" />
          <span>I consent to OSCEN contacting me about this inquiry. We won't share your info.</span>
        </label>

        <!-- Anti-spam CAPTCHA (renders only when PUBLIC_TURNSTILE_SITE_KEY is set) -->
        <Turnstile />

        <button
          type="submit"
          id="investor-submit"
          class="w-full px-7 py-3 rounded-full bg-accent-blue/15 border border-accent-blue/30 text-accent-blue font-medium hover:bg-accent-blue/25 hover:border-accent-blue/50 transition-all duration-300 cursor-pointer disabled:opacity-50"
        >
          Send
        </button>

        <p id="investor-status" role="status" aria-live="polite" class="text-center text-sm font-tech hidden"></p>
      </form>

      <div id="investor-success" tabindex="-1" role="status" class="hidden glass-bright rounded-2xl p-9 text-center focus:outline-none">
        <p class="text-[10px] font-tech text-accent-green uppercase tracking-[0.3em] mb-3">Received</p>
        <h3 id="investor-success-title" class="font-display text-2xl text-text-primary">Thanks. We'll be in touch within 48 hours.</h3>
        <p id="investor-success-detail" class="text-sm text-text-secondary mt-3 max-w-md mx-auto leading-relaxed"></p>
        <a href="/support" data-support-link class="hidden inline-block mt-6 px-6 py-2.5 rounded-full bg-accent-blue/15 border border-accent-blue/30 text-accent-blue text-sm font-medium hover:bg-accent-blue/25 transition-all">Back the brain →</a>
      </div>

      <p class="reveal text-[10px] text-text-muted mt-6 text-center max-w-xl mx-auto leading-relaxed">
        Nothing on this page constitutes an offer to sell or a solicitation to buy any security. All conversations are subject to applicable securities law.
      </p>
    </section>

    <!-- Back -->
    <section class="max-w-5xl mx-auto px-6 text-center">
      <div class="divider max-w-24 mx-auto mb-10"></div>
      <a href="/" class="text-sm font-tech text-accent-blue/70 hover:text-accent-blue transition-colors">← Back to overview</a>
    </section>
  </main>
  <Footer />
  <HandoffOverlay mode="leave" />
</Base>

<script>
  import { SEGMENTS, submitInquiry, trackingForInvestor } from "../lib/forms";
  import { leaveForSupport } from "../scripts/handoff";

  const form = document.getElementById("investor-form-el") as HTMLFormElement | null;
  const btn = document.getElementById("investor-submit") as HTMLButtonElement | null;
  const status = document.getElementById("investor-status") as HTMLElement | null;
  const accreditedFields = document.getElementById("accredited-fields") as HTMLElement | null;
  const successCard = document.getElementById("investor-success") as HTMLElement | null;
  const successDetail = document.getElementById("investor-success-detail") as HTMLElement | null;

  // Reflect accreditation choice into the UI + hidden routing segment.
  // "no" hides the accredited-only fields entirely (no check-size theatre for
  // someone this round can't take).
  function updateAccreditationUI() {
    if (!form || !accreditedFields) return;
    const selected = form.querySelector<HTMLInputElement>('input[name="accreditation"]:checked');
    if (!selected) {
      accreditedFields.classList.add("hidden");
      return;
    }
    accreditedFields.classList.toggle("hidden", selected.value === "no");

    const segmentInput = form.querySelector<HTMLInputElement>('input[name="segment"]');
    if (segmentInput) {
      segmentInput.value =
        selected.value === "yes"
          ? SEGMENTS.investorAccredited
          : selected.value === "no"
          ? SEGMENTS.investorRetail
          : SEGMENTS.investorUnverified;
    }
  }

  form?.querySelectorAll<HTMLInputElement>('input[name="accreditation"]').forEach((input) => {
    input.addEventListener("change", updateAccreditationUI);
  });

  const successTitle = document.getElementById("investor-success-title") as HTMLElement | null;

  // One copy per answer. "no" is shown when someone returns here after the
  // hand-off to /support (Back button, or a reload in the same tab).
  const SUCCESS: Record<string, { title: string; detail: string }> = {
    yes: { title: "Thanks. We'll be in touch within 48 hours.", detail: "We'll reply with the investor brief and a call link." },
    "not-sure": { title: "Thanks. We'll be in touch within 48 hours.", detail: "We'll reply with a quick qualifying question, then the brief." },
    no: {
      title: "Thanks. Your note reached us.",
      detail: "This round is for accredited investors only. The best way to be part of OSCEN today is to back the brain on our Support page.",
    },
  };
  const SUBMITTED_KEY = "oscen_invest_submitted";

  function showSuccess(answer: string) {
    if (!form || !successCard || !successDetail || !successTitle) return;
    const copy = SUCCESS[answer] ?? SUCCESS["not-sure"];
    successTitle.textContent = copy.title;
    successDetail.textContent = copy.detail;
    successCard.querySelector("[data-support-link]")?.classList.toggle("hidden", answer !== "no");
    form.classList.add("hidden");
    successCard.classList.remove("hidden");
    successCard.focus({ preventScroll: true });
  }

  // Already submitted in this tab: don't hand people an empty form to resend.
  try {
    const prior = sessionStorage.getItem(SUBMITTED_KEY);
    if (prior) showSuccess(prior);
  } catch {
    // Storage blocked: the form simply shows again.
  }

  if (form && btn && status) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      submitInquiry(
        form,
        "invest",
        btn,
        status,
        () => {
          const answer = form.querySelector<HTMLInputElement>('input[name="accreditation"]:checked')?.value ?? "not-sure";
          try {
            sessionStorage.setItem(SUBMITTED_KEY, answer);
          } catch {
            // Non-fatal.
          }
          // Not accredited: the inquiry is saved, then we hand off to /support.
          if (answer === "no") {
            leaveForSupport(btn, () => showSuccess("no"));
            return;
          }
          showSuccess(answer);
        },
        trackingForInvestor(form),
      );
    });
  }

  // Touch devices: tap-to-expand on the expand cards
  if ("ontouchstart" in window) {
    document.querySelectorAll<HTMLElement>(".expand-card").forEach((card) => {
      card.addEventListener("click", () => card.classList.toggle("expanded"));
    });
  }
</script>
