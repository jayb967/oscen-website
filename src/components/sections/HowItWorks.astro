---
/**
 * Section: How It Works (redesign-v2). Pinned scroll scene: the brain
 * (persistent canvas behind) re-brightens, the camera glides to one
 * region per step, and oversized captions swap Go2-style bottom-left.
 *
 * Copy + region mapping live in src/data/how-it-works.ts; choreography
 * lives in src/scripts/experience.ts (queries [data-stage] markup).
 * Without JS/with reduced motion this renders as a plain readable list.
 */
import { PIPELINE_STEPS } from "@data/how-it-works";
---

<section id="how-it-works" class="relative">
  <div class="hiw-frame max-w-6xl mx-auto w-full px-6 md:px-10 py-24">
    <div class="hiw-header text-center mb-16">
      <p class="reveal hud-label !text-[10px] !tracking-[0.3em] mb-6 text-text-muted">How It Works</p>
      <h2 class="reveal font-display text-[clamp(2rem,5vw,3.5rem)] text-text-primary leading-tight">
        Five steps.<br />
        <span class="italic gradient-text">Every millisecond.</span>
      </h2>
    </div>

    <div class="hiw-stages relative">
      {PIPELINE_STEPS.map((s, i) => (
        <div
          class="hiw-stage mb-14"
          data-stage
          data-region={s.region}
          data-index={i}
          style={`--stage-accent: var(--color-${s.accent});`}
        >
          <p class="hiw-num hud-label !text-[11px] mb-3 text-scrim" style="color: var(--stage-accent);">
            {s.num} / 05
          </p>
          <h3 class="hiw-title text-text-primary text-scrim" style="font-family: var(--font-tech); font-weight: 700; font-size: clamp(3rem, 8vw, 7rem); line-height: 0.95; letter-spacing: -0.02em;">
            {s.title}
          </h3>
          <p class="hiw-desc mt-5 text-text-primary/90 text-scrim text-[clamp(0.95rem,1.3vw,1.15rem)] leading-relaxed max-w-md">
            {s.desc}
          </p>
        </div>
      ))}
    </div>

    <div class="hiw-footer text-center mt-4">
      <div class="inline-flex items-center gap-3 hud-label !text-[10px] text-text-muted">
        <span class="w-8 h-px bg-gradient-to-r from-transparent to-text-muted/30"></span>
        <span>This loop runs continuously. The brain never stops learning.</span>
        <span class="w-8 h-px bg-gradient-to-l from-transparent to-text-muted/30"></span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Pinned mode (experience.ts adds .hiw-pinned when it takes over):
     the section becomes one viewport; captions stack bottom-left and
     the choreography cross-fades them over the live brain. */
  :global(#how-it-works.hiw-pinned) .hiw-frame {
    height: 100vh;
    max-width: none;
    padding: 0;
    display: block;
  }
  :global(#how-it-works.hiw-pinned) .hiw-header {
    position: absolute;
    top: 7rem;
    left: 0;
    right: 0;
    margin: 0;
  }
  :global(#how-it-works.hiw-pinned) .hiw-stages {
    position: absolute;
    inset: 0;
  }
  :global(#how-it-works.hiw-pinned) .hiw-stage {
    position: absolute;
    left: clamp(1.5rem, 6vw, 6rem);
    bottom: clamp(5rem, 14vh, 9rem);
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  :global(#how-it-works.hiw-pinned) .hiw-footer {
    position: absolute;
    bottom: 2.5rem;
    left: 0;
    right: 0;
    margin: 0;
  }
</style>
