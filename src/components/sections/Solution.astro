---
/**
 * Section 3: The Solution. What OSCEN IS, not how it works.
 * Four expand-on-hover cards. No equations. No jargon.
 * Technical depth lives on /architecture. Copy in src/data/sections.ts.
 */
import { SOLUTION_FEATURES } from "@data/sections";
---

<section id="solution" class="section relative">
  <div class="max-w-4xl mx-auto w-full">
    <div class="text-center mb-20">
      <p class="reveal text-[10px] font-tech text-text-muted uppercase tracking-[0.3em] mb-6">The Answer</p>
      <h2 class="reveal font-display text-[clamp(2rem,5vw,3.5rem)] text-text-primary leading-tight">
        A brain that learns<br />
        <span class="italic gradient-text">like a child.</span>
      </h2>
    </div>

    <!-- Expand cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {SOLUTION_FEATURES.map((f, i) => (
        <div class="expand-card reveal glass glass-ticks rounded-2xl p-6 cursor-pointer group" tabindex="0" style={`--glow-delay: ${i * 1.5}s;`}>
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-medium text-accent-blue group-hover:text-text-primary transition-colors duration-300">
              {f.title}
            </h3>
            <span class="expand-indicator text-accent-blue/40 text-lg">+</span>
          </div>
          <div class="expand-body mt-4">
            <p class="text-sm text-text-secondary leading-relaxed">{f.body}</p>
            <a
              href={f.link}
              class="inline-block mt-4 text-xs font-tech text-accent-blue/70 hover:text-accent-blue transition-colors"
            >
              {f.linkLabel} →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Mobile: tap to toggle expanded state (hover doesn't exist)
  if ("ontouchstart" in window) {
    document.querySelectorAll<HTMLElement>(".expand-card").forEach((card) => {
      card.addEventListener("click", () => card.classList.toggle("expanded"));
    });
  }
</script>
