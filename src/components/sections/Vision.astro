---
/**
 * Section 5: Vision. Where this goes -- merged with the old FounderVision
 * section (Q4 consolidation, 2026-07-24): three pillars, then the
 * three-phase roadmap, one ghost-text close. The picture that makes
 * investors lean forward. Copy in src/data/sections.ts.
 */
import { VISION_PILLARS, VISION_PHASES } from "@data/sections";
---

<section id="vision" class="section relative">
  <div class="max-w-4xl mx-auto w-full">
    <div class="text-center mb-20">
      <p class="reveal text-[10px] font-tech text-text-muted uppercase tracking-[0.3em] mb-6">Vision</p>
      <h2 class="reveal font-display text-[clamp(2rem,5vw,3.5rem)] text-text-primary leading-tight">
        The brain for<br />
        <span class="italic gradient-text">every robot.</span>
      </h2>
    </div>

    <!-- Three pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-24">
      {VISION_PILLARS.map((p, i) => (
        <div class="expand-card reveal glass glass-ticks rounded-2xl p-6 cursor-pointer group text-center" tabindex="0" style={`--glow-delay: ${i * 2}s;`}>
          <span class="text-2xl text-accent-blue/50 group-hover:text-accent-blue transition-colors duration-300">{p.icon}</span>
          <h3 class="text-text-primary font-medium mt-3">{p.title}</h3>
          <span class="expand-indicator inline-block mt-2 text-accent-blue/30 text-sm">+</span>
          <div class="expand-body mt-3">
            <p class="text-sm text-text-secondary leading-relaxed">{p.body}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Three-phase roadmap (from the old FounderVision section) -->
    <div class="relative mb-24">
      <div class="absolute left-6 md:left-8 top-0 bottom-0 w-px bg-gradient-to-b from-accent-blue/30 to-accent-blue/5 hidden md:block"></div>

      <div class="space-y-4">
        {VISION_PHASES.map((p, i) => (
          <div class="expand-card reveal glass glass-ticks rounded-xl p-6 cursor-pointer group md:ml-16 relative" tabindex="0" style={`--glow-delay: ${(i + 3) * 2}s;`}>
            <div class="hidden md:block absolute -left-[calc(4rem+5px)] top-7 w-2.5 h-2.5 rounded-full bg-accent-blue/40 group-hover:bg-accent-blue transition-colors duration-300 ring-4 ring-abyss"></div>

            <div class="flex items-center gap-4">
              <span class="text-[10px] font-tech text-accent-blue uppercase tracking-wider w-12">{p.phase}</span>
              <h3 class="text-lg font-medium text-text-primary group-hover:text-white transition-colors">{p.title}</h3>
              <span class="expand-indicator text-accent-blue/40 text-sm ml-auto">+</span>
            </div>
            <div class="expand-body mt-3 ml-16">
              <p class="text-sm text-text-secondary leading-relaxed">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Founder gut-punch. one close, not two -->
    <div class="text-center">
      <div class="divider max-w-24 mx-auto mb-14"></div>
      <p id="founder-line" class="ghost-text font-display text-[clamp(1.5rem,3.5vw,2.5rem)] text-text-primary leading-snug">
        The question isn't whether robots will think.<br />
        <span class="italic text-text-secondary">It's whether they'll learn.</span>
      </p>
    </div>
  </div>
</section>

<script>
  if ("ontouchstart" in window) {
    document.querySelectorAll<HTMLElement>("#vision .expand-card").forEach((card) => {
      card.addEventListener("click", () => card.classList.toggle("expanded"));
    });
  }
</script>
