---
/**
 * Section 4: Proof. This is real. This is running. Flip cards for depth.
 * Copy in src/data/sections.ts. Green pulse = live status (semantic).
 */
import { PROOF_CARDS } from "@data/sections";
---

<section id="proof" class="section relative">
  <div class="max-w-4xl mx-auto w-full">
    <div class="text-center mb-20">
      <p class="reveal text-[10px] font-tech text-text-muted uppercase tracking-[0.3em] mb-6">Proof</p>
      <h2 class="reveal font-display text-[clamp(2rem,5vw,3.5rem)] text-text-primary leading-tight">
        Not a concept.<br />
        <span class="text-text-secondary">A running system.</span>
      </h2>
    </div>

    <!-- Flip cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
      {PROOF_CARDS.map((p, i) => (
        <div class="flip-card reveal h-48" tabindex="0" role="button" aria-label={`${p.value} ${p.label}. Hover for details.`} style={`--glow-delay: ${i * 1.5}s;`}>
          <div class="flip-inner w-full h-full">
            <div class="flip-front w-full h-full glass-bright glass-ticks rounded-2xl p-5 flex flex-col items-center justify-center text-center">
              <div class="text-2xl md:text-3xl font-tech font-bold tracking-tight text-accent-blue">{p.value}</div>
              <div class="text-xs text-text-muted mt-2 uppercase tracking-wider">{p.label}</div>
            </div>
            <div class="flip-back w-full h-full glass glass-ticks rounded-2xl p-5 flex flex-col items-center justify-center text-center">
              <p class="text-xs text-text-secondary leading-relaxed">{p.back}</p>
              {p.link && (
                <a href={p.link} class="text-[10px] font-tech text-accent-blue/70 hover:text-accent-blue mt-2 transition-colors">
                  {p.linkLabel} →
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Live status. extremely subtle -->
    <div class="reveal text-center">
      <div class="inline-flex items-center gap-3 px-5 py-2 rounded-full border border-border">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-green animate-pulse"></span>
        <span class="text-[10px] font-tech text-text-muted tracking-wider">
          Training continuously on dedicated infrastructure
        </span>
      </div>
    </div>
  </div>
</section>
