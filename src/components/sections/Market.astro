---
/**
 * Section: Market - Competitive landscape and market opportunity.
 * Numbers-first. Comparison table. The "why now" case.
 * Copy in src/data/sections.ts. Table greens = OSCEN advantage
 * (semantic); VLA flaw cards are red (warnings); stats are blue.
 */
import { COMPETITORS, VLA_LIMITS, MARKET_STATS } from "@data/sections";
---

<section id="market" class="section relative">
  <div class="max-w-5xl mx-auto w-full">
    <div class="text-center mb-20">
      <p class="reveal text-[10px] font-tech text-text-muted uppercase tracking-[0.3em] mb-6">The Market</p>
      <h2 class="reveal font-display text-[clamp(2rem,5vw,3.5rem)] text-text-primary leading-tight">
        Everyone is building the body.<br />
        <span class="italic gradient-text">No one is building the brain.</span>
      </h2>
    </div>

    <!-- Market stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-16">
      {MARKET_STATS.map((s, i) => (
        <div class="flip-card reveal h-36" tabindex="0" role="button" aria-label={`${s.value}: ${s.label}`} style={`--glow-delay: ${i * 1.5}s;`}>
          <div class="flip-inner w-full h-full">
            <div class="flip-front w-full h-full glass-bright glass-ticks rounded-xl p-4 flex flex-col items-center justify-center text-center">
              <div class="text-xl md:text-2xl font-tech font-bold text-accent-blue">{s.value}</div>
              <div class="text-[10px] text-text-muted mt-2 uppercase tracking-wider leading-tight">{s.label}</div>
            </div>
            <div class="flip-back w-full h-full glass glass-ticks rounded-xl p-4 flex items-center justify-center text-center">
              <p class="text-[11px] text-text-secondary">{s.sub}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Competitor comparison -->
    <div class="reveal glass glass-ticks rounded-xl overflow-hidden mb-8">
      <div class="overflow-x-auto">
        <table class="w-full text-xs">
          <thead>
            <tr class="border-b border-border">
              <th class="text-left p-4 text-text-muted font-tech font-normal uppercase tracking-wider">Company</th>
              <th class="text-left p-4 text-text-muted font-tech font-normal uppercase tracking-wider">Approach</th>
              <th class="text-left p-4 text-text-muted font-tech font-normal uppercase tracking-wider">Learning</th>
              <th class="text-left p-4 text-text-muted font-tech font-normal uppercase tracking-wider">Edge</th>
              <th class="text-left p-4 text-text-muted font-tech font-normal uppercase tracking-wider">Power</th>
            </tr>
          </thead>
          <tbody>
            {COMPETITORS.map((row) => {
              const isOscen = row.name === "OSCEN";
              return (
                <tr class={`border-b border-border/50 ${isOscen ? 'bg-accent-blue/[0.03]' : ''}`}>
                  <td class={`p-4 ${isOscen ? 'text-accent-blue font-medium' : 'text-text-primary'}`}>{row.name}</td>
                  <td class="p-4 text-text-secondary">{row.approach}</td>
                  <td class={`p-4 ${row.learning === 'Continual' ? 'text-accent-green' : 'text-text-muted'}`}>{row.learning}</td>
                  <td class={`p-4 ${row.edge === 'Yes' ? 'text-accent-green' : 'text-text-muted'}`}>{row.edge}</td>
                  <td class={`p-4 font-tech ${isOscen ? 'text-accent-green' : 'text-text-muted'}`}>{row.energy}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    <p class="reveal text-[10px] text-text-muted text-center font-tech mb-24">
      * Currently training on CPU at ~45W. Targeting purpose-built low-power edge compute at &lt;5W.
    </p>

    <!-- VLA ceiling explainer -->
    <div class="text-center mb-12">
      <p class="reveal text-[10px] font-tech text-text-muted uppercase tracking-[0.3em] mb-6">The VLA ceiling</p>
      <h3 class="reveal font-display text-[clamp(2rem,5vw,3.5rem)] text-text-primary leading-tight">
        Every competitor uses the same playbook.<br />
        <span class="italic gradient-text">It has the same four flaws.</span>
      </h3>
      <p class="reveal text-sm text-text-secondary mt-6 max-w-2xl mx-auto leading-relaxed">
        Vision-Language-Action models are the dominant approach in robotics AI. They work today, but they carry fundamental limitations that no amount of scale can fix.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {VLA_LIMITS.map((item, i) => (
        <div class="expand-card reveal glass glass-ticks rounded-2xl p-6 cursor-pointer group" tabindex="0" style={`--glow-delay: ${i * 1.5}s; --glow-color: var(--color-accent-red);`}>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="text-xl text-accent-red" set:html={item.icon} />
              <h4 class="text-base font-medium text-accent-red group-hover:text-text-primary transition-colors duration-300">
                {item.label}
              </h4>
            </div>
            <span class="expand-indicator text-accent-red/40 text-lg">+</span>
          </div>
          <div class="flex items-baseline gap-2 mt-3">
            <span class="text-2xl font-tech font-bold text-accent-red">{item.stat}</span>
            <span class="text-[10px] text-text-muted uppercase tracking-wider">{item.statLabel}</span>
          </div>
          <div class="expand-body mt-4">
            <p class="text-sm text-text-secondary leading-relaxed">{item.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Mobile: tap to toggle expanded state (hover doesn't exist on touch)
  if ("ontouchstart" in window) {
    document.querySelectorAll<HTMLElement>("#market .expand-card").forEach((card) => {
      card.addEventListener("click", () => card.classList.toggle("expanded"));
    });
  }
</script>
