---
/**
 * Hero (redesign-v2). The brain renders on the persistent experience
 * canvas BEHIND this section (see index.astro); the giant OSCEN
 * back-title sits behind the brain for the depth trick. This section
 * carries only the foreground copy.
 */
---

<section id="hero" class="h-screen w-full overflow-hidden flex items-center justify-center">
  <!-- Bottom fade into the next section -->
  <div class="absolute bottom-0 left-0 right-0 h-64 pointer-events-none" style="background: linear-gradient(to top, var(--color-abyss), transparent);"></div>

  <!-- Content. Deliberately sparse. -->
  <div class="relative text-center max-w-4xl mx-auto px-6 hero-backdrop">
    <p id="hero-eyebrow" class="hud-label !tracking-[0.35em] mb-6 hero-text-shadow">
      Brain software for robots
    </p>
    <h1 id="hero-title" class="font-display text-[clamp(3.5rem,9vw,9rem)] leading-[0.85] tracking-tight hero-text-shadow">
      <span class="block text-text-primary">Intelligence</span>
      <span
        class="block italic mt-1 pb-[0.15em]"
        style="background: linear-gradient(135deg, var(--color-accent-blue) 0%, var(--color-accent-cyan) 40%, var(--color-accent-purple) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; filter: drop-shadow(0 2px 20px rgba(94, 164, 245, 0.3));"
      >that grows</span>
    </h1>

    <p id="hero-subline" class="mt-8 text-text-secondary text-[clamp(0.95rem,1.6vw,1.25rem)] font-display tracking-wide max-w-2xl mx-auto hero-text-shadow">
      Everyone is building the body. <span class="text-text-primary italic">We're building the brain.</span>
    </p>

    <!-- Minimal stat line. whisper-quiet -->
    <div id="hero-stats" class="mt-12 flex items-center justify-center gap-6 text-text-secondary hero-text-shadow" style="font-family: var(--font-tech);">
      <span class="text-[12px] tracking-wider">1.15M neurons</span>
      <span class="text-text-secondary/30">&middot;</span>
      <span class="text-[12px] tracking-wider">~850M plastic synapses</span>
      <span class="text-text-secondary/30">&middot;</span>
      <span class="text-[12px] tracking-wider text-accent-green">Training now</span>
    </div>
  </div>

  <!-- Scroll hint. a single subtle line -->
  <div id="hero-scroll" class="absolute bottom-10 left-1/2 -translate-x-1/2">
    <div class="w-px h-8 bg-gradient-to-b from-transparent to-text-muted/30"></div>
  </div>
</section>

<style>
  .hero-text-shadow {
    text-shadow:
      0 2px 20px rgba(5, 8, 16, 1),
      0 4px 40px rgba(5, 8, 16, 0.95),
      0 8px 80px rgba(5, 8, 16, 0.8),
      0 0 120px rgba(5, 8, 16, 0.6);
  }
  .hero-backdrop {
    background: radial-gradient(ellipse 80% 70% at 50% 50%, rgba(5, 8, 16, 0.72) 0%, rgba(5, 8, 16, 0.38) 55%, transparent 80%);
    padding: 3rem 2rem;
    border-radius: 2rem;
  }
</style>

<script>
  // Mouse parallax straight into the inline stage (the old iframe
  // postMessage was a silent no-op). First interaction still fires the
  // BrainVizPlay conversion once per pageview.
  const hero = document.getElementById("hero")!;
  let brainVizFired = false;
  function reportBrainVizPlay() {
    if (brainVizFired) return;
    brainVizFired = true;
    window.metaTrack?.("BrainVizPlay", { surface: "hero" });
    window.gtmPush?.("brain_viz_play", { surface: "hero" });
  }
  hero.addEventListener("mousemove", (e) => {
    reportBrainVizPlay();
    const x = (e.clientX / window.innerWidth) * 2 - 1;
    const y = (e.clientY / window.innerHeight) * 2 - 1;
    window.__experience?.stage.setPointer(x, y);
  });
  hero.addEventListener("touchstart", reportBrainVizPlay, { passive: true });
  hero.addEventListener("mouseleave", () => {
    window.__experience?.stage.setPointer(0, 0);
  });
</script>
