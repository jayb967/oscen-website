---
/**
 * Public-safe credibility strip.
 *
 * Only facts we can say publicly:
 *   - Patent application number (public on USPTO)
 *   - "Patent pending"
 *
 * DO NOT add award claims, valuation, or anything from oscen-internal.
 * Copy in src/data/sections.ts.
 */
import { PROOF_STRIP_ITEMS } from "@data/sections";
---

<section id="proof-strip" class="py-10">
  <div class="max-w-5xl mx-auto px-6">
    <div class="reveal glass-bright glass-ticks rounded-2xl px-6 py-5">
      <div class="grid grid-cols-2 gap-5">
        {PROOF_STRIP_ITEMS.map((item) => (
          <div class="text-center md:text-left">
            <p class="text-[9px] font-tech uppercase tracking-[0.25em] text-text-secondary">{item.label}</p>
            <p class="mt-1 text-sm font-tech text-text-primary">{item.value}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
