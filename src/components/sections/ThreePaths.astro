---
/**
 * Three conversion paths. Each is a card link.
 *
 * Invest → /invest (qualifying form, accreditation fork)
 * Build  → /build  (collaborator memo flow)
 * Follow → #email-capture (the single Buttondown form, in CTA below)
 *
 * Copy in src/data/sections.ts.
 */
import { CONVERSION_PATHS } from "@data/sections";
---

<section id="three-paths" class="section relative">
  <div class="max-w-5xl mx-auto w-full px-6">
    <div class="text-center mb-12">
      <p class="reveal text-[10px] font-tech text-text-muted uppercase tracking-[0.3em] mb-4">Three ways in</p>
      <h2 class="reveal font-display text-[clamp(2rem,5vw,3.5rem)] text-text-primary leading-tight">
        Pick your <span class="italic gradient-text">path</span>.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {CONVERSION_PATHS.map((p) => (
        <a
          href={p.href}
          data-cta={`path-${p.href.replace(/[^a-z]/g, "") || "anchor"}`}
          class:list={[
            "reveal glass glass-ticks rounded-2xl p-7 group transition-all duration-300 block",
            p.featured ? "border border-accent-amber/40 hover:border-accent-amber/70 shadow-[0_0_40px_-12px_rgba(245,166,35,0.45)]" : "hover:border-border-bright",
          ]}
        >
          <p class:list={["text-[10px] font-tech uppercase tracking-[0.25em]", p.featured ? "text-accent-amber" : "text-accent-blue/70"]}>{p.eyebrow}</p>
          <h3 class="mt-3 text-2xl font-display text-text-primary group-hover:text-accent-blue transition-colors">
            {p.title}
          </h3>
          <p class="mt-3 text-sm text-text-secondary leading-relaxed">{p.desc}</p>
          <div class="mt-5 inline-flex items-center gap-2 text-xs font-tech text-accent-blue/80 group-hover:text-accent-blue transition-colors">
            <span>{p.cta}</span>
            <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
