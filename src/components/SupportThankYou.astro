---
/**
 * Post-checkout thank-you. Renders hidden by default; a client script makes it
 * visible when /support is loaded with ?ok=1 and reads &tier=X to drive copy.
 *
 * The contributor wall + display name are now captured at Stripe checkout and
 * written to the CRM by the Stripe webhook, so this form no longer feeds the
 * wall. It only subscribes the supporter to Buttondown (updates keep flowing
 * during the Buttondown -> CRM migration) and fires the CompleteRegistration
 * pixel. Success = the Buttondown call settled.
 */
import { BUTTONDOWN_ACTION } from "../lib/forms";
---

<section id="support-thanks" class="max-w-5xl mx-auto px-6 mb-20 hidden">
  <div class="reveal glass rounded-xl p-8 border border-accent-amber/30">
    <p class="text-[10px] font-tech text-accent-amber uppercase tracking-[0.3em] mb-3" id="thanks-eyebrow">Thanks</p>
    <h2 class="font-display text-[clamp(1.5rem,3vw,2.5rem)] text-text-primary leading-tight mb-4" id="thanks-headline">
      Thank you.
    </h2>
    <p class="text-sm text-text-secondary leading-relaxed max-w-xl mb-6" id="thanks-body">
      Your support just bought real brain time. Your welcome email is on its way to the address you used at checkout.
    </p>

    <form id="thanks-form" class="space-y-4 max-w-xl" novalidate>
      <input type="hidden" name="tier" id="thanks-tier" value="" />

      <div>
        <label for="thanks-email" class="block text-[11px] font-tech text-text-muted uppercase tracking-wider mb-1.5">
          Optional: also get the public Progress Log
        </label>
        <input
          type="email"
          id="thanks-email"
          name="email"
          required
          autocomplete="email"
          placeholder="your@email.com"
          class="w-full px-4 py-2.5 rounded-lg bg-void/50 border border-border text-sm text-text-primary placeholder-text-muted/40 focus:border-accent-amber/30 focus:outline-none transition-colors"
        />
        <p class="text-[10px] text-text-muted/70 mt-1.5 font-tech">Your perks don't depend on this. It's the occasional public update for everyone following the build.</p>
      </div>

      <div class="flex items-center gap-3 pt-1">
        <button
          type="submit"
          id="thanks-submit"
          class="px-6 py-2.5 rounded-lg bg-accent-amber/10 border border-accent-amber/30 text-accent-amber text-sm font-medium hover:bg-accent-amber/20 hover:border-accent-amber/50 transition-all duration-300 cursor-pointer"
        >
          Subscribe
        </button>
        <button
          type="button"
          id="thanks-skip"
          class="text-[12px] font-tech text-text-muted hover:text-text-primary transition-colors"
        >
          Skip
        </button>
      </div>
      <p id="thanks-status" class="text-xs font-tech mt-2 hidden"></p>
    </form>

    <div id="thanks-done" class="hidden">
      <p class="text-sm text-text-secondary leading-relaxed">
        Got it. Check your inbox to confirm the subscription so you keep getting updates.
      </p>
    </div>
  </div>
</section>

<script define:vars={{ BUTTONDOWN_URL: BUTTONDOWN_ACTION }}>
  const section = document.getElementById("support-thanks");
  if (section) {
    const url = new URL(window.location.href);
    const ok = url.searchParams.get("ok") === "1";
    const rawTier = (url.searchParams.get("tier") || "").toLowerCase();
    const tier = ["spark", "synapse", "cortex", "circle", "custom", "founding", "holiday", "office", "region", "labday", "company"].includes(rawTier) ? rawTier : "";

    if (ok) {
      section.classList.remove("hidden");

      const eyebrow  = document.getElementById("thanks-eyebrow");
      const headline = document.getElementById("thanks-headline");
      const body     = document.getElementById("thanks-body");
      const tierInput = /** @type {HTMLInputElement|null} */ (document.getElementById("thanks-tier"));

      // Mirrors what the CRM actually sends (oscencrm src/lib/support-tiers.ts
      // "next" lines). The welcome email goes to the Stripe checkout address
      // automatically; the form below is only the optional public newsletter.
      const INBOX = "Your welcome email is on its way to the address you used at checkout.";
      const WALL = "If you chose to be listed, your name goes up on the wall below.";
      const COPY = {
        spark: {
          eyebrow: "Name a Neuron",
          headline: "You're in the brain now.",
          body: `${INBOX} Your neuron certificate is attached to it.`,
        },
        synapse: {
          eyebrow: "Milestone Witness Pass",
          headline: "You'll be there when it happens.",
          body: `${INBOX} It has your neuron certificate, and the clips of its first steps and first word will come to the same address the day each happens. ${WALL}`,
        },
        circle: {
          eyebrow: "Circle",
          headline: "Welcome to the Circle.",
          body: `${INBOX} Your first "here's what it learned" clip arrives by the 10th of next month, and your votes on what it learns next come by email. The welcome email also has your neuron certificate and a link to manage or cancel your membership. ${WALL}`,
        },
        cortex: {
          eyebrow: "Inner Circle",
          headline: "Welcome to the Inner Circle.",
          body: `${INBOX} Your first "here's what it learned" clip arrives by the 10th of next month, and your votes and the invite to the next live build session come by email. The welcome email also has your neuron certificate and a link to manage or cancel your membership. Your crewneck ships in 4 to 6 weeks. ${WALL}`,
        },
        founding: {
          eyebrow: "Founding 100",
          headline: "You're one of the hundred.",
          body: `${INBOX} It has your Founding number and your neuron certificate. Your crewneck ships in 4 to 6 weeks. ${WALL}`,
        },
        holiday: {
          eyebrow: "Holiday Gift Box",
          headline: "Gift sorted.",
          body: `${INBOX} It has their neuron certificate to print or forward. The box ships to them by December 20, and we'll email you tracking when it goes out.`,
        },
        office: {
          eyebrow: "Office Hours",
          headline: "Let's talk.",
          body: `${INBOX} It explains how we'll set up your call, held within 30 days. Your crewneck ships in 4 to 6 weeks.`,
        },
        region: {
          eyebrow: "Region Sponsor",
          headline: "A part of the mind has your name on it.",
          body: `${INBOX} It names your region, has your neuron certificate, and explains how we'll set up your call. Your crewneck ships in 4 to 6 weeks.`,
        },
        labday: {
          eyebrow: "Lab Day",
          headline: "See you in the lab.",
          body: `${INBOX} It has a link to split your three crewneck sizes and explains how we'll schedule your session, held within 60 days.`,
        },
        company: {
          eyebrow: "Company Sponsor",
          headline: "Welcome aboard.",
          body: `${INBOX} It has a link to upload your logo and send your team's crewneck sizes, and explains how we'll schedule the talk.`,
        },
        custom: {
          eyebrow: "Supporter",
          headline: "Thank you, for whatever it was.",
          body: `${INBOX} Every dollar buys compute, sensors, or runway. ${WALL}`,
        },
      };

      const copy = tier ? COPY[tier] : null;
      if (copy && eyebrow && headline && body && tierInput) {
        eyebrow.textContent = copy.eyebrow;
        headline.textContent = copy.headline;
        body.textContent = copy.body;
        tierInput.value = tier;
      }

      window.scrollTo({ top: 0, behavior: "instant" });
      headline?.setAttribute("tabindex", "-1");
      headline?.focus({ preventScroll: true });
    }

    const form    = /** @type {HTMLFormElement|null} */ (document.getElementById("thanks-form"));
    const submit  = /** @type {HTMLButtonElement|null} */ (document.getElementById("thanks-submit"));
    const skip    = document.getElementById("thanks-skip");
    const status  = document.getElementById("thanks-status");
    const done    = document.getElementById("thanks-done");

    const TIER_TAG = {
      spark: "supporter-spark",
      synapse: "supporter-synapse",
      cortex: "supporter-cortex",
      circle: "supporter-circle",
      custom: "supporter-custom",
      founding: "supporter-founding",
      holiday: "supporter-holiday",
      office: "supporter-office",
      region: "supporter-region",
      labday: "supporter-labday",
      company: "supporter-company",
    };

    function showDone() {
      if (form) form.classList.add("hidden");
      if (done) done.classList.remove("hidden");
      if (status) status.classList.add("hidden");
      // Strip ?ok and ?tier so a refresh does not re-open the form on an
      // already-completed flow.
      const clean = new URL(window.location.href);
      clean.searchParams.delete("ok");
      clean.searchParams.delete("tier");
      clean.searchParams.delete("session_id");
      window.history.replaceState({}, "", clean.toString());
    }

    // Tier prices in USD for conversion values (custom is unknown here).
    const TIER_VALUE = {
      spark: 20, synapse: 50, circle: 29, cortex: 100, founding: 100, holiday: 175,
      office: 250, region: 500, labday: 2500, company: 5000,
    };

    // Delegates to the shared fan-out (Meta + Reddit + TikTok, one event_id,
    // consent-gated server legs) exposed by the module script below.
    function fireRegistration(email, tierValue) {
      const params = {
        registration_method: "supporter_wall",
        tier: tierValue || "unknown",
        value: TIER_VALUE[tierValue] ?? 0,
        currency: "USD",
      };
      if (typeof window.oscenFireRegistration === "function") {
        window.oscenFireRegistration(params, email);
      }
    }

    function showStatus(msg, ok) {
      if (!status) return;
      status.textContent = msg;
      status.classList.remove("hidden", "text-accent-blue", "text-accent-red");
      status.classList.add(ok ? "text-accent-blue" : "text-accent-red");
    }

    if (skip) skip.addEventListener("click", showDone);

    if (form && submit) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = /** @type {HTMLInputElement} */ (document.getElementById("thanks-email")).value.trim();
        if (!email) { showStatus("Email required.", false); return; }

        const t = /** @type {HTMLInputElement} */ (document.getElementById("thanks-tier")).value;
        const tag = TIER_TAG[t] || "supporter-custom";

        submit.disabled = true;
        const original = submit.textContent;
        submit.textContent = "Sending...";

        const buttondown = new FormData();
        buttondown.append("email", email);
        buttondown.append("tag", tag);
        buttondown.append("embed", "1");

        // Buttondown's embed endpoint is cross-origin with no CORS headers, so
        // we fire no-cors and treat a settled request as success.
        let buttondownOk = false;
        try {
          await fetch(BUTTONDOWN_URL, { method: "POST", mode: "no-cors", body: buttondown });
          buttondownOk = true;
        } catch {
          buttondownOk = false;
        }

        submit.disabled = false;
        submit.textContent = original;

        if (buttondownOk) {
          fireRegistration(email, t);
          showDone();
        } else {
          showStatus("Something went wrong. Email info@oscen.ai and we will sort it out.", false);
        }
      });
    }
  }
</script>

<script>
  // Ad conversions for the Stripe checkout return. Bundled module (can import),
  // reads ?ok / ?tier before anything strips them (only the form's done step does).
  import { fireStandaloneConversion, trackingForPurchase } from "../lib/forms";
  import { TIER_PRICE_USD, TIER_NAMES } from "../lib/support";

  type TierId = keyof typeof TIER_NAMES;

  declare global {
    interface Window {
      oscenFireRegistration?: (params: Record<string, unknown>, email?: string) => void;
    }
  }

  window.oscenFireRegistration = (params, email) => {
    fireStandaloneConversion(
      { event: "CompleteRegistration", route: "registration", customData: params },
      email,
    );
  };

  // Run after DOMContentLoaded: this component's module executes before the
  // consent + pixel modules at the end of Base.astro, so firing now would find
  // no window.oscenConsent / redditTrack / tiktokTrack / metaTrack yet.
  //
  // A Purchase is only reported for a checkout the CRM confirms was paid
  // (/.netlify/functions/checkout-verify asks our record or Stripe), with the
  // real tier and amount. A typed or shared ?ok=1 URL, or a return without a
  // session id, shows the thank-you copy but counts nothing.
  const SESSION_ID = /^cs_(live|test)_[A-Za-z0-9]{10,200}$/;

  function firedKey(sessionId: string) {
    return `oscen_purchase_fired_${sessionId.slice(-56)}`;
  }
  function alreadyFired(key: string): boolean {
    try {
      return localStorage.getItem(key) === "1" || sessionStorage.getItem(key) === "1";
    } catch {
      return false;
    }
  }
  function markFired(key: string) {
    try { localStorage.setItem(key, "1"); } catch { /* storage blocked */ }
    try { sessionStorage.setItem(key, "1"); } catch { /* storage blocked */ }
  }

  type Verified = { ok?: boolean; paid?: boolean; tier?: string | null; value?: number };

  async function verify(sessionId: string): Promise<Verified | null> {
    // The webhook or Stripe can lag the redirect by a moment; try a few times.
    for (let attempt = 0; attempt < 3; attempt++) {
      try {
        const res = await fetch("/.netlify/functions/checkout-verify", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ session_id: sessionId }),
        });
        if (res.ok) {
          const data = (await res.json()) as Verified;
          if (data.ok && data.paid) return data;
          if (data.ok && !data.paid && attempt === 2) return data;
        }
      } catch {
        // network blip: retry
      }
      await new Promise((r) => setTimeout(r, 1500 * (attempt + 1)));
    }
    return null;
  }

  async function firePurchaseOnce() {
    const url = new URL(window.location.href);
    if (url.searchParams.get("ok") !== "1") return;
    const sessionId = url.searchParams.get("session_id") || "";
    if (!SESSION_ID.test(sessionId)) return;
    const key = firedKey(sessionId);
    if (alreadyFired(key)) return;
    const result = await verify(sessionId);
    if (!result?.paid || alreadyFired(key)) return;
    const urlTier = (url.searchParams.get("tier") || "").toLowerCase();
    const tier = result.tier && result.tier in TIER_NAMES ? result.tier : urlTier in TIER_NAMES ? urlTier : "custom";
    const value = typeof result.value === "number" && result.value > 0 ? result.value : TIER_PRICE_USD[tier as TierId];
    markFired(key);
    // The relays cap event ids at 64 chars; the session id's tail is unique on its own.
    fireStandaloneConversion(trackingForPurchase(tier, value), undefined, {}, `cs_${sessionId.slice(-56)}`);
  }

  // Module scripts run while readyState is already "interactive" but before
  // DOMContentLoaded, so only "complete" means it is safe to fire now.
  let purchaseHandled = false;
  const runOnce = () => {
    if (purchaseHandled) return;
    purchaseHandled = true;
    void firePurchaseOnce();
  };
  if (document.readyState === "complete") {
    runOnce();
  } else {
    document.addEventListener("DOMContentLoaded", runOnce, { once: true });
    window.addEventListener("load", runOnce, { once: true });
  }
</script>
