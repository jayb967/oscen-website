---
/**
 * Contributor wall. Sourced live from the CRM at PUBLIC_SUPPORTERS_URL (the CRM
 * filters to public + active + wall-eligible and sorts server-side). This is a
 * static site, so the list is fetched client-side on page load and rendered
 * into the DOM below. The "Be the first" empty state is the default markup and
 * also stays if the list is empty or the fetch fails.
 */
import { LOCAL_SAMPLE_SUPPORTERS, TIER_DOT } from "../data/contributors";

const SUPPORTERS_URL =
  import.meta.env.PUBLIC_SUPPORTERS_URL ?? "https://crm.oscen.ai/api/public/supporters"
// Sample names are a layout aid for local dev only. Never ship them.
const SAMPLE_SUPPORTERS = import.meta.env.DEV ? LOCAL_SAMPLE_SUPPORTERS : []
---

<section class="max-w-5xl mx-auto px-6 mb-24">
  <h2 class="reveal font-display text-[clamp(1.5rem,3vw,2.5rem)] text-text-primary mb-4">Contributors</h2>
  <p class="reveal text-sm text-text-muted mb-12 max-w-xl">
    The people keeping the brain learning. Milestone Witness Pass and above show up here by choice.
  </p>

  <!-- Company sponsors. Hidden until the CRM reports an approved logo. -->
  <div id="sponsor-strip" class="hidden mb-6">
    <p class="text-[10px] font-tech text-text-muted uppercase tracking-[0.3em] mb-4">Company sponsors</p>
    <ul id="sponsor-logos" class="glass rounded-xl p-6 flex flex-wrap items-center gap-x-10 gap-y-6"></ul>
  </div>

  <!-- Empty state: default, and what stays on an empty list or a failed fetch. -->
  <div id="wall-empty" class="reveal glass rounded-xl p-8 text-center">
    <p class="text-sm text-text-secondary">Be the first.</p>
    <p class="text-xs text-text-muted mt-2 font-tech">The wall lights up the moment someone backs the Milestone Witness Pass or above.</p>
  </div>

  <!-- Populated state: revealed by the script once the CRM returns supporters. -->
  <div id="wall-list" class="glass rounded-xl p-6 hidden">
    <ul id="wall-items" class="flex flex-wrap gap-x-5 gap-y-3"></ul>
    <p id="wall-count" class="text-[10px] font-tech text-text-muted mt-6"></p>
  </div>
</section>

<script define:vars={{ supportersUrl: SUPPORTERS_URL, sampleSupporters: SAMPLE_SUPPORTERS, tierDot: TIER_DOT }}>
  (async () => {
    const emptyEl = document.getElementById("wall-empty");
    const listEl = document.getElementById("wall-list");
    const itemsEl = document.getElementById("wall-items");
    const countEl = document.getElementById("wall-count");
    if (!emptyEl || !listEl || !itemsEl || !countEl) return;

    let supporters = [];
    let companies = [];
    try {
      const res = await fetch(supportersUrl, { headers: { Accept: "application/json" } });
      if (res.ok) {
        const data = await res.json();
        if (Array.isArray(data?.supporters)) supporters = [...data.supporters, ...sampleSupporters];
        if (Array.isArray(data?.companies)) companies = data.companies;
      }
    } catch {
      supporters = sampleSupporters;
    }

    if (supporters.length === 0 && sampleSupporters.length > 0) supporters = sampleSupporters;

    // Company sponsor logos: https URLs only, rendered as images (no HTML).
    const strip = document.getElementById("sponsor-strip");
    const logos = document.getElementById("sponsor-logos");
    const validCompanies = companies.filter(
      (c) => c && typeof c.name === "string" && typeof c.logoUrl === "string" && c.logoUrl.startsWith("https://"),
    );
    if (strip && logos && validCompanies.length > 0) {
      for (const c of validCompanies) {
        const li = document.createElement("li");
        const img = document.createElement("img");
        img.src = c.logoUrl;
        img.alt = c.name;
        img.loading = "lazy";
        img.className = "h-10 w-auto max-w-[160px] object-contain opacity-80";
        li.appendChild(img);
        logos.appendChild(li);
      }
      strip.classList.remove("hidden");
    }

    // Keep only well-formed rows, preserving the server's order (biggest gifts
    // first). We deliberately do NOT re-sort here: re-sorting by month would
    // discard that ordering and bury larger backers under newer smaller ones.
    const clean = supporters
      .filter((s) => s && typeof s.displayName === "string" && s.displayName.trim())
      .map((s) => ({
        displayName: s.displayName.trim(),
        tier: s.tier,
        since: typeof s.since === "string" ? s.since : "",
        foundingNumber: Number.isInteger(s.foundingNumber) ? s.foundingNumber : null,
        region: typeof s.region === "string" ? s.region : "",
      }));

    if (clean.length === 0) return; // Nothing eligible: leave the empty state.

    const fallbackDot = tierDot.custom;
    for (const s of clean) {
      const li = document.createElement("li");
      li.className = "flex items-center gap-2 text-sm text-text-secondary";

      const dot = document.createElement("span");
      dot.className = `w-1.5 h-1.5 rounded-full ${tierDot[s.tier] || fallbackDot}`;
      dot.setAttribute("aria-hidden", "true");

      const name = document.createElement("span");
      name.textContent = s.displayName; // textContent = no HTML injection.

      li.append(dot, name);

      // Founding 100 number and sponsored region, as the CRM reports them.
      const badge = s.foundingNumber
        ? `#${String(s.foundingNumber).padStart(3, "0")}`
        : s.region ? s.region : "";
      if (badge) {
        const tag = document.createElement("span");
        tag.className = "text-[10px] font-tech text-accent-amber/80";
        tag.textContent = badge;
        li.appendChild(tag);
      }
      itemsEl.appendChild(li);
    }

    countEl.textContent =
      `${clean.length} ${clean.length === 1 ? "supporter" : "supporters"}. Want off the wall? Email info@oscen.ai.`;

    emptyEl.classList.add("hidden");
    listEl.classList.remove("hidden");
  })();
</script>
