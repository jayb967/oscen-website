---
/**
 * /invest sections 2-4: market signals, why now, the energy problem.
 * Homepage visual vocabulary (eyebrow + two-tone headline, glass-ticks
 * cards, oversized font-tech numbers). Count-ups, bar draws and rail
 * draws are wired in src/scripts/invest-motion.ts via data attributes;
 * the HTML always carries the final values.
 */
import SectionHead from "./SectionHead.astro";
import { BRAIN_STATS } from "../../data/brain";
import "../../styles/invest.css";

const SIGNALS = [
  { value: "$1.4T", label: "Robotics market by 2030", sub: "Goldman Sachs", color: "text-accent-blue" },
  { value: "$200M+", label: "Brain-inspired AI VC in 2025", sub: "3× from 2024", color: "text-accent-blue" },
  { value: `${(BRAIN_STATS.totalNeurons / 1_000_000).toFixed(2)}M`, label: "Neurons training live", sub: "Today, not pitched", color: "text-accent-green" },
  { value: "Few", label: "SNN players building robot brains", sub: "Most sell chips, not brains", color: "text-accent-blue" },
];

const ENERGY = [
  { label: "GPT-4o", value: "~1,080 joules per query", source: "Epoch AI, 2025", bar: 100, text: "text-accent-red", fill: "bg-accent-red/50" },
  { label: "Gemini", value: "~864 joules per prompt", source: "Google official", bar: 80, text: "text-accent-amber", fill: "bg-accent-amber/50" },
  { label: "GPU Robot Brain", value: "50-200 joules per second", source: "Industry standard", bar: 90, text: "text-accent-red", fill: "bg-accent-red/50" },
  { label: "OSCEN on neuromorphic silicon", value: "<5 joules per second (projected)", source: "Estimate from published SNN benchmarks, not measured", bar: 5, text: "text-accent-green", fill: "bg-accent-green/60" },
];

const RIVALS = [
  { name: "AMI (JEPA)", approach: "GPU pretraining", flaw: "No continual learning", flawColor: "text-accent-red" },
  { name: "Prometheus", approach: "VLA transformer", flaw: "Frozen, GPU-scale", flawColor: "text-accent-red" },
  { name: "Figure / π", approach: "Transformer VLA", flaw: "Static, 50-200W", flawColor: "text-accent-red" },
  { name: "Google", approach: "Gemini VLA", flaw: "Retrain to update", flawColor: "text-accent-amber" },
];
---

<!-- 2. Market signals (public-safe) -->
<section class="max-w-5xl mx-auto px-6 pb-8 md:pb-12">
  <div class="text-center mb-8">
    <p class="reveal inv-eyebrow text-[10px] font-tech text-text-muted uppercase tracking-[0.3em]">Market signals</p>
  </div>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    {SIGNALS.map((stat) => (
      <div class="reveal glass-bright glass-ticks inv-topline rounded-2xl px-4 py-6 text-center">
        <div class={`text-2xl md:text-3xl font-tech font-bold tracking-tight ${stat.color}`}>
          <span class="inv-count" data-countup>{stat.value}</span>
        </div>
        <div class="text-[10px] text-text-secondary mt-3 uppercase tracking-wider leading-tight">{stat.label}</div>
        <div class="text-[10px] font-tech text-text-muted mt-2">{stat.sub}</div>
      </div>
    ))}
  </div>
</section>

<!-- 3. Why now. AMI validates the thesis -->
<section class="inv-section inv-glow max-w-5xl mx-auto px-6">
  <SectionHead
    eyebrow="Why now"
    title="The market is moving beyond LLMs."
    accent="The biggest names in AI agree."
    lede="But their solutions still have the same old problems."
  />

  <div class="reveal glass-bright glass-ticks rounded-2xl p-6 md:p-8 mb-4">
    <div class="relative pl-7" data-rail-wrap>
      <span class="inv-rail left-[0.4rem]" data-rail aria-hidden="true"></span>
      <ol class="space-y-8">
      <li class="relative">
        <span class="inv-node absolute -left-7 top-1" aria-hidden="true"></span>
        <span class="inline-block px-3 py-1 rounded-full bg-accent-blue/10 border border-accent-blue/30 text-accent-blue text-[10px] font-tech uppercase tracking-wider">March 2026</span>
        <p class="text-sm md:text-base text-text-primary font-medium mt-3">Yann LeCun's AMI Labs raises $1.03B for "world models"</p>
        <p class="text-xs md:text-sm text-text-secondary mt-1 leading-relaxed">The Turing Award winner left Meta to build JEPA, world models that go beyond LLMs. Nvidia, Toyota, Samsung, Jeff Bezos invested. The thesis: <span class="text-text-primary">LLMs are not enough for robots.</span></p>
      </li>
      <li class="relative">
        <span class="inv-node absolute -left-7 top-1" aria-hidden="true"></span>
        <span class="inline-block px-3 py-1 rounded-full bg-accent-blue/10 border border-accent-blue/30 text-accent-blue text-[10px] font-tech uppercase tracking-wider">June 2026</span>
        <p class="text-sm md:text-base text-text-primary font-medium mt-3">Jeff Bezos's Project Prometheus raises $12B at $41B valuation</p>
        <p class="text-xs md:text-sm text-text-secondary mt-1 leading-relaxed">Bezos + Vik Bajaj as co-CEOs. JPMorgan, Goldman Sachs, BlackRock in. Founding advisors include Ashish Vaswani and Jakob Uszkoreit, two of the original "Attention Is All You Need" authors. Pitched as "physical AI" for industrial design and manufacturing. <span class="text-text-primary">Wall-Street-scale capital is now pouring into physical AI.</span></p>
      </li>
      </ol>
    </div>
    <div class="divider my-6"></div>
    <p class="text-xs md:text-sm text-text-secondary leading-relaxed">AMI and Prometheus both still train on GPU clusters, still deploy frozen models, still can't learn on-device, and still have no answer for catastrophic forgetting. <span class="text-accent-blue">OSCEN is designed to answer all four.</span></p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-5 gap-3 text-center">
    {RIVALS.map((r) => (
      <div class="reveal glass rounded-xl px-3 py-4">
        <div class="text-sm font-tech text-text-primary">{r.name}</div>
        <div class="text-[10px] text-text-secondary mt-1">{r.approach}</div>
        <div class={`text-[10px] mt-0.5 ${r.flawColor}`}>{r.flaw}</div>
      </div>
    ))}
    <div class="reveal col-span-2 md:col-span-1 glass-bright glass-ticks rounded-xl px-3 py-4 border-accent-blue/40 shadow-[0_0_24px_rgba(94,164,245,0.12)]">
      <div class="text-sm font-tech text-accent-blue font-medium">OSCEN</div>
      <div class="text-[10px] text-text-secondary mt-1">Spiking Neural Net</div>
      <div class="text-[10px] text-accent-green mt-0.5">Continual, &lt;5W target</div>
    </div>
  </div>
</section>

<!-- 4. The energy problem -->
<section class="inv-section max-w-5xl mx-auto px-6">
  <SectionHead
    eyebrow="The energy problem"
    title="Robots need intelligence that runs on batteries,"
    accent="not data centers."
    lede="Current AI is unsustainable for edge deployment."
  />

  <div class="reveal glass glass-ticks rounded-2xl p-6 md:p-8 mb-12">
    <div class="space-y-6">
      {ENERGY.map((item) => (
        <div>
          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-1 mb-2">
            <div>
              <span class="text-sm text-text-primary">{item.label}</span>
              <span class="block sm:inline text-[9px] font-tech text-text-muted sm:ml-2">{item.source}</span>
            </div>
            <span class={`text-[11px] md:text-xs font-tech ${item.text}`}>{item.value}</span>
          </div>
          <div class="h-1.5 rounded-full bg-elevated overflow-hidden">
            <div class={`inv-bar h-full rounded-full ${item.fill}`} data-bar style={`width: ${item.bar}%`}></div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="text-center">
    <div class="divider max-w-24 mx-auto mb-10"></div>
    <p class="ghost-text font-display text-[clamp(1.5rem,3.5vw,2.5rem)] text-text-primary leading-snug max-w-3xl mx-auto">
      Event-driven compute only runs when neurons fire,<br class="hidden md:block" />
      <span class="italic text-text-secondary">not idle GPU cycles.</span>
    </p>
    <p class="reveal text-xs text-text-muted mt-6">The architecture is ready; the compute layer is catching up.</p>
    <p class="reveal text-[10px] text-text-muted mt-2 max-w-xl mx-auto">
      1 watt = 1 joule per second. LLM figures are energy per interaction (~0.3 Wh and ~0.24 Wh converted to joules); robot brains draw power continuously.
    </p>
  </div>
</section>

<script>
  import "../../scripts/invest-motion";
</script>
