---
/**
 * Full-screen hand-off between pages. Two modes, one markup:
 *
 *   mode="leave"  (/invest)   A non-accredited inquiry went through. The
 *                             overlay opens as a circle from the submit
 *                             button, shows the message, draws the "axon"
 *                             progress line, then navigates to /support.
 *   mode="arrive" (/support)  Loaded with ?from=invest. The overlay is shown
 *                             before first paint (inline script) and closes
 *                             like an iris onto the page.
 *
 * Animation logic lives in src/scripts/handoff.ts. Nothing here is visible
 * unless a script removes `hidden`, so a no-JS visitor never sees it.
 */
interface Props {
  mode: "leave" | "arrive";
}
const { mode } = Astro.props;
---

<div
  id="handoff"
  data-mode={mode}
  class="hidden fixed inset-0 z-[200]"
  role="dialog"
  aria-modal="true"
  aria-labelledby={mode === "leave" ? "handoff-title" : undefined}
  aria-label={mode === "arrive" ? "Loading" : undefined}
>
  <div data-handoff-bg class="absolute inset-0 bg-abyss"></div>

  <div class="relative h-full flex items-center justify-center px-4 sm:px-6">
    <div class="max-w-xl w-full text-center">
      <div data-handoff-neuron class="handoff-neuron mx-auto mb-10" aria-hidden="true">
        <span class="ring"></span>
        <span class="ring ring-2"></span>
        <span class="core"></span>
      </div>

      {mode === "leave" && (
        <div data-handoff-copy aria-live="polite">
          <p data-handoff-item class="text-[10px] font-tech text-accent-green uppercase tracking-[0.3em] mb-4">Received</p>
          <h2 id="handoff-title" data-handoff-item class="font-display text-[clamp(2rem,5vw,3.25rem)] text-text-primary leading-[1.05]">
            Thank you.<br />
            <span class="italic gradient-text">Here's the best way in.</span>
          </h2>
          <p data-handoff-item class="text-sm sm:text-base text-text-secondary leading-relaxed mt-6 max-w-md mx-auto">
            This round is open to accredited investors only, so right now the best way to be part of OSCEN is to back the brain directly.
            We have your details, and we'll reach out about anything else.
          </p>

          <div data-handoff-item class="mt-10 max-w-sm mx-auto">
            <div class="axon relative h-px bg-border-bright">
              <div data-handoff-fill class="absolute inset-0 bg-accent-blue origin-left scale-x-0"></div>
              <div data-handoff-spike class="spike absolute top-1/2 -translate-y-1/2 -translate-x-1/2 left-0"></div>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-3 mt-4">
              <span class="text-[10px] font-tech text-text-muted uppercase tracking-[0.25em]">Taking you to Support</span>
              <span class="flex items-center gap-5">
                <button
                  type="button"
                  data-handoff-stay
                  class="text-[11px] font-tech text-text-muted hover:text-text-primary transition-colors cursor-pointer"
                >
                  Stay here
                </button>
                <a
                  href="/support?from=invest"
                  data-handoff-go
                  class="text-[11px] font-tech text-accent-blue/80 hover:text-accent-blue transition-colors"
                >
                  Go now →
                </a>
              </span>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</div>

{mode === "arrive" && (
  <script is:inline>
    // Runs before first paint so /support never flashes underneath. The
    // timeout is a safety net in case the animation module never loads.
    (function () {
      var el = document.getElementById("handoff");
      if (!el || new URLSearchParams(location.search).get("from") !== "invest") return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      el.classList.remove("hidden");
      el.dataset.armed = "1";
      setTimeout(function () { el.classList.add("hidden"); }, 3000);
    })();
  </script>
)}

<style>
  .handoff-neuron {
    position: relative;
    width: 56px;
    height: 56px;
  }
  .handoff-neuron .core {
    position: absolute;
    inset: 22px;
    border-radius: 9999px;
    background: var(--color-accent-blue);
    box-shadow: 0 0 18px 4px rgba(94, 164, 245, 0.55);
  }
  .handoff-neuron .ring {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 1px solid rgba(94, 164, 245, 0.45);
    animation: handoff-pulse 2.2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  .handoff-neuron .ring-2 {
    animation-delay: 1.1s;
  }
  .spike {
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: #fff;
    box-shadow: 0 0 12px 3px rgba(94, 164, 245, 0.8);
  }
  @keyframes handoff-pulse {
    from { transform: scale(0.35); opacity: 1; }
    to   { transform: scale(1.6); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .handoff-neuron .ring { animation: none; opacity: 0.4; }
  }
</style>
