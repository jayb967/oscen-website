---
/**
 * First in Line: free sign-up for a place in line, plus the "your place"
 * view (fresh join, returning visitor, or ?line=<code>&confirmed=1).
 *
 * Posts to the same-origin relay netlify/functions/line-join.ts. Client
 * logic lives in src/scripts/line-join.ts; every dynamic string is set with
 * textContent. A place in line is a promise of first access, not of a robot.
 */
import SectionHead from "../invest/SectionHead.astro";
import Turnstile from "../Turnstile.astro";

const inputClass =
  "mt-2 w-full px-4 py-3 rounded-lg bg-deep border border-border-bright text-base sm:text-sm text-text-primary placeholder-text-muted focus:border-accent-blue focus:ring-2 focus:ring-accent-blue/30 focus:outline-none transition-all";
const chipClass =
  "inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full border border-border-bright bg-void/40 text-xs font-tech text-text-primary hover:border-accent-blue/50 hover:text-accent-blue transition-colors cursor-pointer";
---

<section id="join" class="inv-section inv-glow max-w-3xl mx-auto px-6 scroll-mt-24">
  <SectionHead
    eyebrow="First in Line"
    title="Get your place in line."
    accent="It's free."
    lede="One email, one place in line. When reservations open, the line goes first, in order."
  />

  <p id="line-notice" role="status" aria-live="polite" class="hidden mb-5 text-center text-sm font-tech"></p>

  <form
    id="line-form"
    aria-label="Join the line"
    class="reveal glass-bright glass-ticks inv-topline rounded-2xl p-6 md:p-9 space-y-5 shadow-2xl shadow-black/40"
    action="/.netlify/functions/line-join"
    method="POST"
    novalidate
  >
    <input type="hidden" name="ref" id="line-ref" value="" />
    <div class="hidden" aria-hidden="true">
      <label>Don't fill this: <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-[1.4fr_1fr] gap-4">
      <label class="block">
        <span class="text-[11px] font-tech text-text-secondary uppercase tracking-wider">Email</span>
        <input id="line-email" type="email" name="email" required autocomplete="email" inputmode="email" placeholder="you@example.com" class={inputClass} />
      </label>
      <label class="block">
        <span class="text-[11px] font-tech text-text-secondary uppercase tracking-wider">First name (optional)</span>
        <input type="text" name="first_name" maxlength="60" autocomplete="given-name" class={inputClass} />
      </label>
    </div>

    <Turnstile />

    <button
      type="submit"
      id="line-submit"
      class="w-full px-7 py-3.5 rounded-full bg-accent-blue text-void font-medium text-sm tracking-wide hover:bg-accent-cyan transition-colors duration-300 cursor-pointer disabled:opacity-60 shadow-[0_0_28px_rgba(94,164,245,0.3)]"
    >
      Get my place in line
    </button>
    <p id="line-status" role="status" aria-live="polite" class="hidden text-center text-sm font-tech"></p>
    <p class="text-[11px] text-text-muted text-center leading-relaxed">
      Free. We'll email you once to confirm your place, then only when there's real news. Unsubscribe anytime.
    </p>
  </form>

  <!-- Your place. Shown after joining, for a returning visitor, or after confirming. -->
  <div id="line-success" tabindex="-1" class="hidden glass-bright glass-ticks inv-topline rounded-2xl p-6 md:p-10 focus:outline-none shadow-2xl shadow-black/40">
    <p id="line-eyebrow" class="text-[10px] font-tech text-accent-green uppercase tracking-[0.3em] mb-3">Your place</p>
    <h3 id="line-position" class="font-display text-[clamp(2.25rem,6vw,3.75rem)] text-text-primary leading-[1.02]">You're in line.</h3>
    <p id="line-confirm" class="mt-3 text-base text-text-secondary">Check your email to confirm your place.</p>
    <p id="line-group" class="hidden mt-2 text-sm text-accent-amber"></p>
    <p id="line-referrals" class="hidden mt-2 text-sm text-accent-green"></p>

    <div id="line-share" class="mt-8">
      <label for="line-link" class="block text-[11px] font-tech text-text-secondary uppercase tracking-wider mb-2">Your link</label>
      <div class="flex flex-col sm:flex-row gap-2">
        <input id="line-link" type="text" readonly value="" class="flex-1 min-w-0 px-4 py-3 rounded-lg bg-deep border border-border-bright text-sm font-tech text-accent-blue focus:outline-none focus:border-accent-blue" />
        <button type="button" id="line-copy" class="px-5 py-3 rounded-lg bg-accent-blue/15 border border-accent-blue/30 text-accent-blue text-sm font-medium hover:bg-accent-blue/25 transition-colors cursor-pointer">Copy link</button>
      </div>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" id="line-native-share" class={`hidden ${chipClass}`}>Share</button>
        <a id="line-share-x" href="https://x.com" target="_blank" rel="noopener" class={chipClass}>Share on X</a>
        <a id="line-share-reddit" href="https://www.reddit.com" target="_blank" rel="noopener" class={chipClass}>Share on Reddit</a>
      </div>
    </div>

    <div class="mt-9 pt-7 border-t border-border-bright">
      <p class="text-[10px] font-tech text-text-muted uppercase tracking-[0.3em] mb-4">How to move up</p>
      <ol class="space-y-3 text-sm text-text-secondary leading-relaxed">
        <li class="flex gap-3"><span class="font-tech text-accent-blue shrink-0">01</span><span><a href="#circle" class="text-text-primary underline decoration-accent-blue/40 underline-offset-4 hover:text-accent-blue">Back the brain.</a> Every backer goes ahead of all free sign-ups. More backing, further ahead.</span></li>
        <li class="flex gap-3"><span class="font-tech text-accent-blue shrink-0">02</span><span><span class="text-text-primary">Share your link.</span> Each friend who joins and confirms moves you up 10 places.</span></li>
        <li class="flex gap-3"><span class="font-tech text-accent-blue shrink-0">03</span><span><span class="text-text-primary">The Founding 100</span> hold the first 100 places in line.</span></li>
      </ol>
    </div>

    <button type="button" id="line-reset" class="mt-8 text-[11px] font-tech text-text-muted hover:text-text-primary transition-colors cursor-pointer">Not you? Use a different email</button>
  </div>

  <p id="line-total" class="hidden mt-6 text-center text-xs font-tech text-text-muted"></p>
</section>

<script>
  import "../../scripts/line-join";
</script>
