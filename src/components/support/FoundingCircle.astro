---
/**
 * The Founding Circle: the two monthly plans (Circle $29, Inner Circle $100,
 * tier id "cortex") side by side, then a comparison table. A plan with no
 * live Stripe link is not rendered (lib/support.ts); the table only shows
 * when both plans are live.
 */
import SectionHead from "../invest/SectionHead.astro";
import { CIRCLE_TIERS, CIRCLE_PERKS } from "../../lib/support";

const circle = CIRCLE_TIERS.find((t) => t.id === "circle");
const inner = CIRCLE_TIERS.find((t) => t.id === "cortex");

const PLANS = [
  circle && {
    tier: circle,
    cta: "Join the Circle",
    perks: CIRCLE_PERKS,
    frame: "glass-bright glass-ticks border border-accent-blue/25",
    priceColor: "text-accent-blue",
    dot: "bg-accent-blue",
    button: "bg-accent-blue/15 border border-accent-blue/35 text-accent-blue hover:bg-accent-blue/25",
  },
  inner && {
    tier: inner,
    cta: "Join the Inner Circle",
    perks: inner.stack,
    frame: "glass-bright glass-ticks border border-accent-amber/35 line-inner",
    priceColor: "text-accent-amber",
    dot: "bg-accent-amber",
    button: "bg-accent-amber text-void hover:bg-accent-amber/85",
  },
].filter((p): p is NonNullable<typeof p> => !!p);

type Cell = boolean | string;
const COMPARE: { label: string; circle: Cell; inner: Cell }[] = [
  { label: "Monthly \"here's what it learned\" clip", circle: true, inner: true },
  { label: "Vote on what it learns next", circle: true, inner: true },
  { label: "Vote on the humanoid's name", circle: true, inner: true },
  { label: "Members-only build log", circle: true, inner: true },
  { label: "A neuron named for you, with a certificate", circle: true, inner: true },
  { label: "Place in line", circle: "Ahead of all free sign-ups", inner: "Ahead of all Circle members" },
  { label: "Early access when reservations open", circle: "24 hours", inner: "72 hours" },
  { label: "Quarterly live build session with the founder", circle: false, inner: true },
  { label: "OSCEN-branded crewneck with your first month", circle: false, inner: true },
];
---

{PLANS.length > 0 && (
  <section id="circle" class="inv-section inv-glow max-w-5xl mx-auto px-6 scroll-mt-24">
    <SectionHead
      eyebrow="The Founding Circle"
      title="Raise the brain"
      accent="with us."
      lede="A monthly plan for the people who want to watch it learn, have a say in what it learns, and stand near the front of the line."
    />

    <div class:list={["grid grid-cols-1 gap-5", PLANS.length > 1 && "md:grid-cols-2"]}>
      {PLANS.map((p) => (
        <div class:list={["reveal relative rounded-2xl p-7 md:p-9 flex flex-col", p.frame]}>
          {p.tier.id === "cortex" && (
            <span class="absolute -top-3 right-6 px-3 py-1 rounded-full bg-accent-amber text-void text-[10px] font-tech uppercase tracking-[0.2em]">Closest to the build</span>
          )}
          <h3 class="font-display text-3xl text-text-primary">{p.tier.name}</h3>
          <p class="mt-3 flex items-baseline gap-1.5">
            <span class:list={["font-tech text-5xl font-bold tracking-tight", p.priceColor]}>{p.tier.price}</span>
            <span class="text-sm font-tech text-text-muted">/month</span>
          </p>
          <p class="mt-4 text-sm text-text-secondary leading-relaxed">{p.tier.blurb}</p>
          <ul class="mt-6 mb-8 space-y-3">
            {p.perks.map((perk) => (
              <li class="flex gap-3 text-sm text-text-secondary leading-relaxed">
                <span class:list={["mt-2 w-1.5 h-1.5 rounded-full shrink-0", p.dot]} aria-hidden="true"></span>
                <span>{perk}</span>
              </li>
            ))}
          </ul>
          <div class="mt-auto">
            <a
              href={p.tier.href}
              data-tier={p.tier.id}
              class:list={["flex items-center justify-center w-full px-6 py-3.5 rounded-full text-sm font-medium tracking-wide transition-colors duration-300", p.button]}
            >
              {p.cta}
            </a>
            <p class="mt-3 text-center text-[11px] font-tech text-text-muted">{p.tier.ships}</p>
          </div>
        </div>
      ))}
    </div>

    {circle && inner && (
      <div class="reveal mt-8 glass rounded-2xl overflow-hidden">
        <table class="w-full text-left text-xs sm:text-sm">
          <caption class="sr-only">Circle and Inner Circle compared</caption>
          <thead>
            <tr class="border-b border-border-bright">
              <th scope="col" class="px-3 sm:px-6 py-4 text-[10px] font-tech text-text-muted uppercase tracking-[0.2em] font-normal">Compare</th>
              <th scope="col" class="px-2 sm:px-6 py-4 text-center font-tech text-accent-blue font-medium w-[27%]">Circle<span class="block text-[10px] text-text-muted font-normal">{circle.price}/mo</span></th>
              <th scope="col" class="px-2 sm:px-6 py-4 text-center font-tech text-accent-amber font-medium w-[27%]">Inner Circle<span class="block text-[10px] text-text-muted font-normal">{inner.price}/mo</span></th>
            </tr>
          </thead>
          <tbody>
            {COMPARE.map((row) => (
              <tr class="border-b border-border last:border-0">
                <th scope="row" class="px-3 sm:px-6 py-3 font-normal text-text-secondary leading-snug">{row.label}</th>
                {[row.circle, row.inner].map((cell) => (
                  <td class="px-2 sm:px-6 py-3 text-center leading-snug">
                    {cell === true ? <span class="text-accent-green" aria-label="Included">✓</span>
                      : cell === false ? <span class="text-text-muted" aria-label="Not included">-</span>
                      : <span class="text-text-primary">{cell}</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <p class="reveal mt-5 text-center text-[11px] font-tech text-text-muted">Billed monthly, cancel anytime.</p>
  </section>
)}

<style>
  .line-inner {
    box-shadow: 0 0 60px -18px rgba(245, 166, 35, 0.35);
  }
</style>
