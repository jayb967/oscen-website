---
/**
 * The whole /support page: First in Line + the Founding Circle. Rendered by
 * src/pages/support.astro and by the short campaign URL src/pages/first.astro;
 * the canonical URL is always /support.
 *
 * Order: hero, free join, Founding Circle (monthly), one-time tiers, what's
 * real, FAQ, where it goes, contributors, other ways, fine print.
 * Paid ads land on /invest; non-accredited visitors are handed off here with
 * ?from=invest (welcome note + HandoffOverlay below). For-profit entity, so
 * "support" / "back" only, never "donation".
 */
import Base from "../../layouts/Base.astro";
import Nav from "../Nav.astro";
import Footer from "../Footer.astro";
import SupportThankYou from "../SupportThankYou.astro";
import ContributorWall from "../ContributorWall.astro";
import HandoffOverlay from "../HandoffOverlay.astro";
import LineHero from "./LineHero.astro";
import LineJoin from "./LineJoin.astro";
import FoundingCircle from "./FoundingCircle.astro";
import GoFurther from "./GoFurther.astro";
import SupportTruth from "./SupportTruth.astro";
import "../../styles/invest.css";

const WHERE = [
  { stat: "1M + 3", label: "Brains running in parallel", body: "One million-neuron generalist and three 100K specialists, all learning live." },
  { stat: "Sensors", label: "Cameras, IMUs, mics", body: "Real bodies need real sensors. Every contribution buys the brain new ways to feel the world." },
  { stat: "Runway", label: "Time to keep building", body: "We are not VC-funded yet. Every backer buys days of focused work on the brain instead of consulting." },
];
const OTHER = [
  { href: "/build", title: "Build with us →", body: "Engineers, neuroscientists, roboticists. If you want to put hands on a real brain, come work on it." },
  { href: "/invest", title: "Invest →", body: "Accredited investors. We're raising to extend runway and scale the body program." },
  { href: "mailto:info@oscen.ai", title: "Just say hi →", body: "info@oscen.ai. Critique, encouragement, an introduction. All of it helps." },
];
---

<Base
  title="First in Line for the OSCEN Humanoid | OSCEN"
  description="Be first in line for the OSCEN humanoid. Join free, or back the brain and move to the front. A brain learning on ordinary CPUs, patent pending."
  canonicalPath="/support"
>
  <Nav />

  <main class="pt-28 md:pt-32 pb-24">
    <SupportThankYou />

    <!-- Welcome note for visitors handed off from the /invest form. -->
    <section id="support-welcome" tabindex="-1" class="max-w-5xl mx-auto px-6 mb-12 hidden focus:outline-none">
      <div class="glass rounded-xl p-6 border border-accent-blue/25">
        <p class="text-[10px] font-tech text-accent-blue uppercase tracking-[0.3em] mb-2">Your note reached us</p>
        <p class="text-sm text-text-secondary leading-relaxed max-w-2xl">
          Thanks for reaching out about investing. Our current round is for accredited investors only, so backing the brain here is the best way to be part of OSCEN today.
          We have your details and we'll reach out about anything else.
        </p>
      </div>
    </section>

    <LineHero />

    <!-- Recent backers. Hidden until the CRM reports enough real backers. -->
    <section id="backers-ticker" class="max-w-5xl mx-auto px-6 mb-6 hidden" aria-label="Recent backers">
      <div class="glass rounded-xl px-5 py-4 flex flex-col md:flex-row md:items-center gap-3 md:gap-6">
        <p class="flex items-center gap-2 text-[10px] font-tech text-accent-green uppercase tracking-[0.25em] shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-green animate-pulse" aria-hidden="true"></span>
          <span id="backers-ticker-count"></span>
        </p>
        <ul id="backers-ticker-list" class="flex flex-wrap gap-x-6 gap-y-2"></ul>
      </div>
    </section>

    <LineJoin />
    <FoundingCircle />
    <GoFurther />
    <SupportTruth />

    <!-- Where money goes -->
    <section class="inv-section max-w-5xl mx-auto px-6">
      <h2 class="reveal font-display text-[clamp(1.5rem,3vw,2.5rem)] text-text-primary mb-4">Where it goes</h2>
      <p class="reveal text-sm text-text-muted mb-10 max-w-xl">No marketing budget, no fancy office. Just the cost of running brains.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        {WHERE.map((w) => (
          <div class="reveal glass rounded-xl p-5">
            <div class="text-2xl font-tech text-accent-blue">{w.stat}</div>
            <div class="text-xs text-text-muted mt-1">{w.label}</div>
            <p class="text-[11px] text-text-secondary mt-2 leading-relaxed">{w.body}</p>
          </div>
        ))}
      </div>
    </section>

    <ContributorWall />

    <!-- Other ways -->
    <section class="max-w-5xl mx-auto px-6 mb-20">
      <h2 class="reveal font-display text-[clamp(1.5rem,3vw,2.5rem)] text-text-primary mb-4">Other ways to help</h2>
      <div class="space-y-3">
        {OTHER.map((o) => (
          <a href={o.href} class="reveal glass rounded-xl p-5 block group hover:border-accent-blue/30 transition-all duration-300">
            <h3 class="text-sm font-medium text-accent-blue group-hover:text-text-primary transition-colors">{o.title}</h3>
            <p class="text-xs text-text-secondary mt-1 leading-relaxed">{o.body}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- The fine print, said plainly -->
    <section class="max-w-5xl mx-auto px-6 mb-20">
      <p class="reveal text-[11px] text-text-muted max-w-3xl leading-relaxed">
        OSCEN is a for-profit company, not a registered charity, and support is not tax-deductible.
        Backing gives no equity, ownership, or financial return, and it is not a pre-order or a deposit.
        A place in line is a promise of first access when reservations open, not of a robot, a price, or a date.
        Perks are personal thank-you gifts. Every physical perk has a ship window on its card; if we miss it, you get a full refund.
        Named neurons and sponsored regions are honorary labels kept by OSCEN.
      </p>
    </section>

    <section class="max-w-5xl mx-auto px-6 text-center">
      <div class="divider max-w-24 mx-auto mb-10"></div>
      <a href="/" class="text-sm font-tech text-accent-blue/70 hover:text-accent-blue transition-colors">← Back to overview</a>
    </section>
  </main>
  <Footer />
  <HandoffOverlay mode="arrive" />
</Base>

<script>
  import { arriveFromInvest } from "../../scripts/handoff";
  import { loadSupportStatus } from "../../scripts/support-status";

  loadSupportStatus();

  // Real deadlines hold even if nobody redeploys after the date passes.
  document.querySelectorAll<HTMLElement>("[data-expires]").forEach((card) => {
    if (Date.now() >= Date.parse(card.dataset.expires ?? "")) (card.closest("[data-tier-wrap]") ?? card).remove();
  });

  if (new URLSearchParams(location.search).get("from") === "invest") {
    const welcome = document.getElementById("support-welcome");
    welcome?.classList.remove("hidden");
    arriveFromInvest();
    // Orient keyboard and screen-reader users to the note, not the page top.
    welcome?.focus({ preventScroll: true });
  }
</script>
