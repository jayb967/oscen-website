---
/**
 * "Your place in line" highlight shown on every support card, near the top so
 * it reads before the perks. One component so every card says it the same way.
 */
interface Props {
  text: string;
  size?: "sm" | "md";
}
const { text, size = "sm" } = Astro.props;
---

<p
  class:list={[
    "line-badge inline-flex items-center gap-2 self-start rounded-full border border-accent-green/40 bg-accent-green/10 text-accent-green font-tech",
    size === "md" ? "px-3.5 py-1.5 text-xs" : "px-3 py-1 text-[11px]",
  ]}
>
  <svg viewBox="0 0 12 12" class="w-3 h-3 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 10V2M2.5 5.5 6 2l3.5 3.5" />
  </svg>
  <span><span class="text-text-primary/90">Your place:</span> {text}</span>
</p>

<style>
  .line-badge {
    box-shadow: 0 0 18px -6px rgba(56, 217, 122, 0.55);
  }
</style>
