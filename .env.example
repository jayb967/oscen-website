# OSCEN website env vars. Copy to .env.local for dev; set in Netlify for prod.
#
# PUBLIC_* vars are inlined into the client bundle by Astro. Vars WITHOUT the
# PUBLIC_ prefix are read only inside Netlify Functions (server-side) and never
# reach the browser. Keep secrets un-prefixed.

# Your Buttondown handle (visible at buttondown.com/<handle>). Defaults to "oscen".
# PUBLIC_BUTTONDOWN_USERNAME=oscen

# Inquiry relay (netlify/functions/inquiry.ts). SERVER-ONLY, never PUBLIC_.
# The contact / invest / build forms POST same-origin to the relay, which
# forwards to the CRM with INQUIRY_SECRET as a Bearer token.
#   CRM_ENDPOINT   = the CRM inquiries URL (defaults to the value below in prod)
#   INQUIRY_SECRET = shared secret; MUST match the value set on the CRM site
# CRM_ENDPOINT=https://crm.oscen.ai/api/inquiries
# INQUIRY_SECRET=
#
# KILL SWITCH: inquiry forwarding is OFF by default (spam mitigation, 2026-08-21).
# Set INQUIRY_ENABLED="true" in Netlify to turn submissions back on WITHOUT a
# redeploy. Remove once the CAPTCHA fix ships (see PROGRESS.md).
# INQUIRY_ENABLED=true

# Contributor wall source (src/components/ContributorWall.astro). PUBLIC read-only
# endpoint. Defaults to the URL below if unset.
# PUBLIC_SUPPORTERS_URL=https://crm.oscen.ai/api/public/supporters

# Plausible analytics. Set ENABLED=true after adding the domain in Plausible.
PUBLIC_PLAUSIBLE_DOMAIN=oscen.ai
PUBLIC_PLAUSIBLE_ENABLED=false
