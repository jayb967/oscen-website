# OSCEN website env vars. Copy to .env.local for dev; set in Netlify for prod.
#
# PUBLIC_* vars are inlined into the client bundle by Astro. Vars WITHOUT the
# PUBLIC_ prefix are read only inside Netlify Functions (server-side) and never
# reach the browser. Keep secrets un-prefixed.

# Your Buttondown handle (visible at buttondown.com/<handle>). Defaults to "oscen".
# PUBLIC_BUTTONDOWN_USERNAME=oscen

# Inquiry relay (netlify/functions/inquiry.ts). SERVER-ONLY, never PUBLIC_.
# The contact / invest / build forms POST same-origin to the relay, which
# forwards to the CRM with INQUIRY_SECRET as a Bearer token.
#   CRM_ENDPOINT   = the CRM inquiries URL (defaults to the value below in prod)
#   INQUIRY_SECRET = shared secret; MUST match the value set on the CRM site
# CRM_ENDPOINT=https://crm.oscen.ai/api/inquiries
# INQUIRY_SECRET=
#
# KILL SWITCH: inquiry forwarding is ON by default (Cloudflare Turnstile now
# guards the forms). Emergency off-switch: set INQUIRY_ENABLED="false" in Netlify
# to drop all submissions without a redeploy. Any other value (or unset) = on.
# INQUIRY_ENABLED=false

# Cloudflare Turnstile CAPTCHA on the 3 inquiry forms (anti-spam).
#   PUBLIC_TURNSTILE_SITE_KEY = public site key; inlined into the client bundle
#     at BUILD time (widget only renders when set -> requires a redeploy).
#   TURNSTILE_SECRET_KEY      = SERVER-ONLY secret; the relay verifies tokens via
#     /siteverify only when this is set. Never PUBLIC_.
# Get both from Cloudflare dash -> Turnstile -> add widget for oscen.ai.
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Spam FLAG-ONLY denylist (server-only). Comma-separated substrings matched
# case-insensitively across name/company/email/message; each hit adds to the
# forwarded spam_score (the CRM flags high scores). Never blocks. Add current
# campaign tells here, e.g. SPAM_DENYLIST="robertjaf". No redeploy needed.
# SPAM_DENYLIST=

# Contributor wall source (src/components/ContributorWall.astro). PUBLIC read-only
# endpoint. Defaults to the URL below if unset.
# PUBLIC_SUPPORTERS_URL=https://crm.oscen.ai/api/public/supporters

# Plausible analytics. Set ENABLED=true after adding the domain in Plausible.
PUBLIC_PLAUSIBLE_DOMAIN=oscen.ai
PUBLIC_PLAUSIBLE_ENABLED=false

# Reddit + TikTok ad pixels and server legs (2026-10-08). Same consent gate as
# Meta: nothing loads or posts until the visitor grants consent.
#   PUBLIC_REDDIT_PIXEL_ID  = Reddit Ads > Events Manager > your pixel's id (public)
#   REDDIT_CAPI_TOKEN       = Events Manager > Conversions API > generate a
#                             conversion access token. SERVER-ONLY secret.
#   REDDIT_CAPI_TEST_ID     = optional, Events Manager test id while verifying
# PUBLIC_REDDIT_PIXEL_ENABLED=false
# PUBLIC_REDDIT_PIXEL_ID=
# REDDIT_CAPI_TOKEN=
# REDDIT_CAPI_TEST_ID=
#
#   PUBLIC_TIKTOK_PIXEL_ID      = TikTok Ads Manager > Tools > Events > your web
#                                 pixel's code (public)
#   TIKTOK_EVENTS_ACCESS_TOKEN  = same pixel > Settings > Events API > generate
#                                 access token. SERVER-ONLY secret.
#   TIKTOK_TEST_EVENT_CODE      = optional, the pixel's Test Events tab code
# PUBLIC_TIKTOK_PIXEL_ENABLED=false
# PUBLIC_TIKTOK_PIXEL_ID=
# TIKTOK_EVENTS_ACCESS_TOKEN=
# TIKTOK_TEST_EVENT_CODE=
#
# PUBLIC_* values are inlined at BUILD time: changing them needs a redeploy.
